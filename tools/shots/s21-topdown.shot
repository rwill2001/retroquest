# Island 1 — the torch-lit overhead grid, one square at a time.
# Lirandel authors no dungeons: its descents are procedural, which is exactly why it
# is the TOP_DOWN island. So this shot generates a map rather than loading one, and
# no two takes are the same dungeon.
DESC="Island 1 · Lirandel · TOP-DOWN grid"
SCENE=procedural
ISLAND=lirandel
MODE=TOP_DOWN
SECONDS_LEN=7
MOVE="0.9:F,1.8:F,2.7:F,3.6:F,4.5:F,5.4:F"
# The top-down pass draws a fixed tile size, so a native 1080p render leaves the grid
# small in a mostly black frame. Render at a third and triple it with nearest-neighbour:
# 32px tiles become 96px, which is the bold overhead grid the shot is asking for.

# Zoom the tile viewport to its minimum (24x18 -> 10x10, stepping by 2) so the torch-lit
# island of explored map fills the frame instead of sitting in the middle of it.
ZOOM=7
WIDTH=640
HEIGHT=360
UPSCALE=1920:1080
