# The 37-spell book, open in combat — which is where the script's spellbook shot happens
# and the only context that lists all of them. Outside combat the book filters to the nine
# map-usable spells, which undersells it by a factor of four.
DESC="The spellbook, mid-combat · 37 spells"
SCENE=combat
ISLAND=lirandel
OVERLAY=spellbook
LEARN_ALL=on
SECONDS_LEN=7
MOVE="1.4:J,2.2:J,3.0:J,3.8:J,4.6:J,5.4:J"
WIDTH=960
HEIGHT=540
UPSCALE=1920:1080
