  "interiorEntryX": 10,
  "interiorEntryY": 13,
  "npcs": [
    {
      "id": "npc_pyralis_maren",
      "name": "Maren the Wanderer",
      "spriteName": "npcs/shopkeeper",
      "type": "QUESTGIVER",
      "defaultDialog": "Shh... keep your voice down.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start",
        "nodes": {
          "start": {
            "id": "start",
            "text": "Shh... keep your voice down. I'm Maren, and I need your help.",
            "choices": [
              {
                "label": "What kind of help?",
                "nextNodeId": "explain"
              },
              {
                "label": "Not interested.",
                "nextNodeId": "decline"
              }
            ],
            "actions": []
          },
          "explain": {
            "id": "explain",
            "text": "Pyralis's forge cult has enslaved the stone-shapers. I'm smuggling refugees out through the tide-caves. Will you help me?",
            "choices": [
              {
                "label": "I'll help you.",
                "nextNodeId": "accept"
              },
              {
                "label": "Not interested.",
                "nextNodeId": "decline"
              }
            ],
            "actions": []
          },
          "accept": {
            "id": "accept",
            "text": "Thank the tides. Take this � the Shard of Ambition. The forge cult wants it to fuel their war machine. I need you to keep it safe and bring it to the southern caves.",
            "choices": [
              {
                "label": "I'll protect it."
              }
            ],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "shard_of_ambition",
                "value": "",
                "amount": 0
              },
              {
                "type": "GIVE_ITEM",
                "target": "shard_of_ambition",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "shard_quest_maren_path",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "decline": {
            "id": "decline",
            "text": "Then keep walking. And keep your mouth shut about seeing me.",
            "choices": [
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          }
        }
      },
      "x": 60,
      "y": 100
    },
    {
      "id": "npc_pyralis_dross",
      "name": "Dross",
      "spriteName": "npcs/blacksmith",
      "type": "TOWNSFOLK",
      "defaultDialog": "...friend?",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start",
        "nodes": {
          "start": {
            "id": "start",
            "text": "...friend? Dross... remembers... friends.",
            "choices": [
              {
                "label": "What are you?",
                "nextNodeId": "what_are_you"
              },
              {
                "label": "What do you know about the mines?",
                "nextNodeId": "mines"
              },
              {
                "label": "Tam sent me. Tell me about the others in the mines.",
                "nextNodeId": "dross_lists",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_slag_lists",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "dross_told_lists",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "goodbye"
              }
            ],
            "actions": []
          },
          "what_are_you": {
            "id": "what_are_you",
            "text": "Made. In forges. Not... supposed to think. But Dross thinks. Dross remembers.",
            "choices": [
              {
                "label": "What do you know about the mines?",
                "nextNodeId": "mines"
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "goodbye"
              }
            ],
            "actions": []
          },
          "mines": {
            "id": "mines",
            "text": "Dark. Hot. Others like Dross... but they don't think. They just... work. Dross ran.",
            "choices": [
              {
                "label": "What are you?",
                "nextNodeId": "what_are_you"
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "goodbye"
              }
            ],
            "actions": []
          },
          "goodbye": {
            "id": "goodbye",
            "text": "Friend... go? Dross... wait here. Dross always waits.",
            "choices": [
              {
                "label": "Take care, Dross."
              }
            ],
            "actions": []
          },
          "dross_lists": {
            "id": "dross_lists",
            "text": "Tam. [The word comes out slowly and carefully, like something carried in both hands.] Tam is the one who writes.\nDross remembers writing. Dross remembers a hand. Not... this hand.\n[It holds up something that was a hand.]\nOthers in the mine. Rows. They work. They do not stop and they do not look up and when one breaks they take the pieces to the front and make another one and it is not a new one, friend. It is the same. Same, with more of somebody else in it.\nDross was in a row. Dross was in a row for a long time. And then one day Dross thought: this is hot.\nThat was all. That was the whole of it. This is hot — and that was thinking, and thinking is not allowed, and Dross ran and Dross has been waiting ever since for someone to come and be a friend, because that is the other thing Dross remembers and Dross does not know from where.\n[It waits.]\nTell Tam. Tell Tam that Dross said: we were the list.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "dross_told_lists",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Dross: \"We were the list.\"",
                "value": "WARN",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 100,
      "y": 85
    },
    {
      "id": "npc_pyralis_reld",
      "name": "Sergeant Reld",
      "spriteName": "npcs/knight",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Hold... you're not one of them. I'm Sergeant Reld of the Forge Guard. My patrol was ambushed by slag beasts three days ago. I'm the only one left.",
            "choices": [
              {
                "label": "The Guard Captain sent me to find you.",
                "nextNodeId": "relief",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "lost_patrol",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "What happened to your men?",
                "nextNodeId": "ambush",
                "conditions": []
              },
              {
                "label": "Are you alright?",
                "nextNodeId": "wounded",
                "conditions": []
              },
              {
                "label": "Good luck, soldier.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "relief": {
            "id": "relief",
            "text": "Thank the forge. Tell the Captain the eastern lava fields are overrun � slag beasts have a breeding nest near the old pumice caves. We walked right into it. My men fought bravely, but... there were too many. I'll make my way back to the Keep once I can walk properly.",
            "choices": [
              {
                "label": "I'll report back to the Captain.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "LOG_MESSAGE",
                "target": "Sergeant Reld reports a slag beast breeding nest near the eastern pumice caves.",
                "value": "",
                "amount": 0
              }
            ]
          },
          "ambush": {
            "id": "ambush",
            "text": "We were scouting the eastern lava fields when they came out of the ground. Six, maybe eight slag beasts. Bigger than any I've seen. They moved together, like a pack. That's not normal � something's organizing them down in the deep.",
            "choices": [
              {
                "label": "That sounds ominous.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "wounded": {
            "id": "wounded",
            "text": "Broken ribs, burns on my left side, and I'm pretty sure my ankle is cracked. But I'm alive, which is more than I can say for the others. If you see Ashara in the village, tell her I'll need patching up.",
            "choices": [
              {
                "label": "Hang in there.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Pyralis keep you. And... thank you.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 120,
      "y": 55
    },
    {
      "id": "npc_pyralis_valdris",
      "name": "Valdris the Hermit",
      "spriteName": "npcs/sage",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "...another one comes. I've been waiting. The mountain told me you would arrive.",
            "choices": [
              {
                "label": "Old Soot sent me. He said you have a warning.",
                "nextNodeId": "warning",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "hermits_warning",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Who are you?",
                "nextNodeId": "identity",
                "conditions": []
              },
              {
                "label": "What are you doing out here alone?",
                "nextNodeId": "purpose",
                "conditions": []
              },
              {
                "label": "Tell me about the volcano.",
                "nextNodeId": "volcano",
                "conditions": []
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "warning": {
            "id": "warning",
            "text": "Listen carefully. The mountain's heartbeat has changed. For twenty years I've felt its rhythm � slow, steady, patient. Now it quickens. Something stirs in the deep forges, something that was sealed long ago. The seven shards were scattered for a reason. If someone gathers them all... the Forge Eternal will reignite. And this island will be consumed.",
            "choices": [
              {
                "label": "The Forge Eternal? What is that?",
                "nextNodeId": "forge_eternal",
                "conditions": []
              },
              {
                "label": "I'll carry your warning to the others.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "LOG_MESSAGE",
                "target": "Valdris warns: the mountain's rhythm has changed. Something stirs in the deep forges.",
                "value": "",
                "amount": 0
              }
            ]
          },
          "forge_eternal": {
            "id": "forge_eternal",
            "text": "That is what the forge cult calls it. They will tell you the gods built it to shape the world, and that Pyralis was its keeper. The older stories name it differently — they say the Forge was never a thing the gods made, but the dreaming of the world itself, and that the seven of them broke it and took a piece each. Ambition is Pyralis’s piece. Believe whichever you like. Both stories end the same way: if the seven are gathered and the Forge relit, this island burns first.",
            "choices": [
              {
                "label": "This is bigger than I thought.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "heard_forge_eternal_lore",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "identity": {
            "id": "identity",
            "text": "I was a scholar in the great library of the mainland, before it burned. I came here to study the volcano � to understand the fire that shaped these islands. Twenty years later, I understand less than when I started. The mountain keeps its secrets well.",
            "choices": [
              {
                "label": "What have you learned?",
                "nextNodeId": "volcano",
                "conditions": []
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "purpose": {
            "id": "purpose",
            "text": "Someone has to watch. The forge cult thinks Pyralis speaks through fire and ritual, but the mountain speaks through tremors and ash. I read its moods the way a sailor reads the sea. When the ground shakes three times in a night, trouble follows within the week.",
            "choices": [
              {
                "label": "Has it been shaking recently?",
                "nextNodeId": "recent_tremors",
                "conditions": []
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "recent_tremors": {
            "id": "recent_tremors",
            "text": "Seven tremors. Last night alone. In twenty years, I've never felt more than four. Something below is waking up. Something old. The forge cult celebrates it as a sign of Pyralis's favor. I call it a countdown.",
            "choices": [
              {
                "label": "A countdown to what?",
                "nextNodeId": "warning",
                "conditions": []
              }
            ],
            "actions": []
          },
          "volcano": {
            "id": "volcano",
            "text": "This volcano is not ordinary stone and magma. The tunnels below are too regular, too purposeful. Someone � or something � carved them. The deeper you go, the more it resembles architecture. Corridors. Chambers. A forge the size of a cathedral. The dungeon entrances are just the upper floors of something much, much larger.",
            "choices": [
              {
                "label": "That's unsettling.",
                "nextNodeId": "greeting",
                "conditions": []
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "The mountain watches, even when you think you're alone. Remember that.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 145,
      "y": 110
    }
  ],
