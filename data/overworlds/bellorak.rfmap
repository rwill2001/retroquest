  "interiorEntryX": 10,
  "interiorEntryY": 13,
  "npcs": [
    {
      "id": "npc_bellorak_brothers",
      "name": "Brothers Three",
      "spriteName": "npcs/guard",
      "type": "QUESTGIVER",
      "defaultDialog": "We were three brothers \u2014 one joined the Gold Guard, one the Iron Reckoners, and I remained. Now I search for them both.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start",
        "nodes": {
          "start": {
            "id": "start",
            "text": "[Three bedrolls surround a dead fire. Only one figure sits here.] We were three brothers \u2014 one joined the Gold Guard, one the Iron Reckoners, and I remained. The war took them both. I still search.",
            "choices": [
              {
                "label": "What happened to them?",
                "nextNodeId": "brothers"
              },
              {
                "label": "Why do you stay?",
                "nextNodeId": "stay"
              },
              {
                "label": "[Leave]",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "brothers": {
            "id": "brothers",
            "text": "Aldric marched north with the Gold Guard. Corran dug trenches for the Iron Reckoners in the south. Neither has sent word in months. If you find dog tags bearing their names in the dungeons beneath, bring them to me.",
            "choices": [
              {
                "label": "I'll look for them.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "stay": {
            "id": "stay",
            "text": "Because someone must remember that this war is not glory. It is brothers killing brothers. The Arena at the center \u2014 they call it sport. I call it Bellorak's cruelest joke.",
            "choices": [
              {
                "label": "The Arena?",
                "nextNodeId": "arena"
              },
              {
                "label": "[Leave]",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "arena": {
            "id": "arena",
            "text": "The Great Arena. Where both factions send their champions to settle disputes. At its heart lies a portal to the Cradle of Shards \u2014 where Bellorak's trial awaits. Only the worthy pass through.",
            "choices": [
              {
                "label": "I'll find your brothers.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "end": {
            "id": "end",
            "text": "[He stares at the cold fire, lost in thought.]",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 115,
      "y": 130
    },
    {
      "id": "npc_bellorak_iron_ghost",
      "name": "Iron Ghost",
      "spriteName": "npcs/thief",
      "defaultDialog": "The Iron Pit swallows soldiers whole. What comes back up is not the same.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start",
        "nodes": {
          "start": {
            "id": "start",
            "text": "[A scarred veteran stands near the pit entrance, leaning on a broken pike.] I went down there once. Came back missing three days and half my squad. The Iron Pit swallows soldiers whole.",
            "choices": [
              {
                "label": "What's down there?",
                "nextNodeId": "below"
              },
              {
                "label": "Who are you?",
                "nextNodeId": "who"
              },
              {
                "label": "[Leave]",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "below": {
            "id": "below",
            "text": "Old weapons. Old bones. The war has been going on longer than anyone admits. Bellorak didn't start it \u2014 he just made sure it never ends. Down there you'll see: the dead of a hundred campaigns, still fighting.",
            "choices": [
              {
                "label": "I'll be careful.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "who": {
            "id": "who",
            "text": "They call me Iron Ghost. I was an Iron Reckoner once. Now I'm neither side. I just watch the pit and warn fools like you. Not that it ever helps.",
            "choices": [
              {
                "label": "Thanks for the warning.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "end": {
            "id": "end",
            "text": "[Iron Ghost turns back to the pit, watching the darkness below.]",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 145,
      "y": 118
    }
  ],
