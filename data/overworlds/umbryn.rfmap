    "180,55": {
      "overrideId": "\u0000",
      "data": {
        "dungeonName": "archive_of_tears"
      }
    },
    "100,79": {
      "data": {
        "message": "A ghostly voice whispers: 'I left my child at the docks... I never came back.'",
        "oneTime": "true"
      }
    },
    "130,82": {
      "data": {
        "message": "The echo of a soldier: 'We held the line for three days. On the fourth, the shadows took us.'",
        "oneTime": "true"
      }
    },
    "163,49": {
      "data": {
        "message": "A woman's memory lingers: 'He promised to return from the Archive. The door never opened again.'",
        "oneTime": "true"
      }
    },
    "128,107": {
      "data": {
        "message": "A child's echo: 'Mama said the shadows are just memories. But memories can hurt.'",
        "oneTime": "true"
      }
    },
    "4,40": {
      "data": {
        "message": "An old scholar's ghost: 'The Archive of Tears contains every sorrow ever shed. I added mine.'",
        "oneTime": "true"
      }
    },
    "66,153": {
      "data": {
        "god": "UMBRYN",
        "favor": "5",
        "xp": "130",
        "message": "A shadow-wreathed altar to Umbryn absorbs the light around it."
      }
    },
    "87,25": {
      "data": {
        "god": "UMBRYN",
        "favor": "8",
        "xp": "150",
        "message": "This shrine to the Shadow God is cold to the touch. Memories flood your mind."
      }
    },
    "134,13": {
      "data": {
        "tier": "5",
        "gold": "50",
        "message": "Beneath layers of shadow-stained earth, you find forgotten treasures."
      }
    },
    "7,176": {
      "data": {
        "tier": "5",
        "gold": "45",
        "message": "A grief-laden cache, buried by someone who wanted to forget."
      }
    },
    "6,83": {
      "data": {
        "tier": "4",
        "gold": "40",
        "message": "The shadows reluctantly yield what they have swallowed."
      }
    },
    "7,139": {
      "data": {
        "monsterId": "memory_shade",
        "lootTier": "5",
        "message": "A memory shade materializes before you, reliving its final battle!"
      }
    },
    "50,14": {
      "data": {
        "monsterId": "echo_knight",
        "lootTier": "5",
        "message": "An echo knight raises its spectral blade!"
      }
    },
    "201,117": {
      "data": {
        "tier": "4",
        "gold": "35",
        "message": "Silver rubble hides a scholar’s strongbox, its lock long since rotted away."
      }
    },
    "164,127": {
      "data": {
        "message": "An echo of a ferryman: ‘I carried them across. Not one of them looked back.’",
        "oneTime": "true"
      }
    },
    "41,74": {
      "data": {
        "god": "UMBRYN",
        "favor": "4",
        "xp": "110",
        "message": "A cracked shrine on the ghost road. The shadows here bow rather than bite."
      }
    },
    "126,46": {
      "data": {
        "monsterId": "memory_shade",
        "lootTier": "5",
        "message": "The rifts tear open and a memory shade steps out of your own recollection!"
      }
    },
    "168,95": {
      "data": {
        "tier": "4",
        "gold": "30",
        "message": "Under a toppled spire, a courier’s satchel — still sealed, still waiting."
      }
    },
    "70,80": {
      "data": {
        "message": "A lamplighter’s echo: ‘I lit them every dusk. One night the flames refused to catch.’",
        "oneTime": "true"
      }
    },
    "197,84": {
      "data": {
        "god": "UMBRYN",
        "favor": "5",
        "xp": "125",
        "message": "A shrine of black glass. Your reflection in it is a stranger."
      }
    },
    "100,51": {
      "data": {
        "tier": "5",
        "gold": "40",
        "message": "A vault beneath the Silver Ruins yields what its owners could not carry."
      }
    },
    "87,105": {
      "data": {
        "message": "A cartographer’s echo: ‘I mapped every trench. The last one mapped me.’",
