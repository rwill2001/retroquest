  "interiorEntryX": 10,
  "interiorEntryY": 13,
  "npcs": [
    {
      "id": "npc_umbryn_eryn",
      "name": "Shade of Eryn",
      "spriteName": "npcs/monk",
      "defaultDialog": "I died in the Shattering. Umbryn caught my last thought and kept it. I exist only as a memory now.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start",
        "nodes": {
          "start": {
            "id": "start",
            "text": "[A translucent figure stands motionless, gazing at nothing.] I died in the Shattering. Umbryn caught my last thought and kept it. I exist only as a memory now. Is that enough?",
            "choices": [
              {
                "label": "What do you remember?",
                "nextNodeId": "remember"
              },
              {
                "label": "I'm sorry.",
                "nextNodeId": "sorry"
              },
              {
                "label": "Would you give one of those away?",
                "nextNodeId": "shade_day",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_archive_of_small_things",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "day_shade",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Leave]",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "remember": {
            "id": "remember",
            "text": "The sound of rain on stone. A child laughing. The warmth of bread from the oven. These are all I am now — fragments of a life that once meant everything.",
            "choices": [
              {
                "label": "Those are worth keeping.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "sorry": {
            "id": "sorry",
            "text": "Don't be. I had a life. Most memories here can't say even that much. The Nameless in The Hollow to the west — they've lost everything. Even their names.",
            "choices": [
              {
                "label": "The Nameless?",
                "nextNodeId": "nameless"
              },
              {
                "label": "[Leave]",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "nameless": {
            "id": "nameless",
            "text": "Mourner Vel tends them. She is the only one who still tries to coax their identities back. Speak with her if you seek understanding of what Umbryn's domain truly costs.",
            "choices": [
              {
                "label": "I will.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "end": {
            "id": "end",
            "text": "[The shade turns back to the darkness, already forgetting you were here.]",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "shade_day": {
            "id": "shade_day",
            "text": "Give one away? [The shade turns, and it is the first time it has turned.]\nIf I give one away I have two. I am three fragments. You are asking me to be a third smaller.\n[A pause exactly the length of the thing it is not saying.]\nTake the bread. Not the rain, and not the child; I will need those. But the bread — out of the oven, on a cold morning, and it was too hot to hold and I held it anyway.\nSomeone should have it who can still be warm. That is not me any more and I have known it for some while.\n[It hands over nothing at all, and your hand closes on something.]",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_ITEM",
                "target": "ordinary_day",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "day_shade",
                "value": "true",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "UMBRYN",
                "value": "",
                "amount": 5
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The Shade of Eryn gives away one of its three memories.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 100,
      "y": 130
    },
    {
      "id": "npc_umbryn_chronicler",
      "name": "The Chronicler",
      "spriteName": "npcs/sage",
      "defaultDialog": "The Archive holds memories too precious to lose. Seek Archivist Sable in Dusthaven.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start",
        "nodes": {
          "start": {
            "id": "start",
            "text": "[A hooded figure studies the ward-circle.] You seek entry to the Archive of Tears? Echo Point lies just to the south. But first, speak with Archivist Sable in Dusthaven — four memory crystals are fading, and the knowledge they hold must not be lost.",
            "choices": [
              {
                "label": "What are memory crystals?",
                "nextNodeId": "crystals"
              },
              {
                "label": "Where is Dusthaven?",
                "nextNodeId": "directions"
              },
              {
                "label": "[Leave]",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "crystals": {
            "id": "crystals",
            "text": "Umbryn stores the world's most important memories in crystallized form. But the crystals degrade over time. When a crystal fails, the memory it holds is lost forever — as if it never happened.",
            "choices": [
              {
                "label": "I'll find Sable.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "directions": {
            "id": "directions",
            "text": "Follow the ghost path south and then west. Dusthaven is the largest settlement on this island — built among the ruins of a much greater city. You cannot miss it.",
            "choices": [
              {
                "label": "Thank you.",
                "nextNodeId": "end"
              }
            ],
            "actions": []
          },
          "end": {
            "id": "end",
            "text": "[The Chronicler returns to studying the wards, muttering about failing resonances.]",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 170,
      "y": 65
    }
  ],
