                "target": "mycos_spore_quest",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "overgrowth": {
            "id": "overgrowth",
            "text": "The overgrowth is Sylvandar's grief made manifest. He lost the world once. Now he clings too tightly, growing life until it becomes a prison. The cure is not destruction — it is acceptance of loss.",
            "choices": [
              {
                "label": "Can the cycle be restored?",
                "nextNodeId": "restore"
              },
              {
                "label": "Wise words.",
                "nextNodeId": "bye"
              }
            ],
            "actions": []
          },
          "bye": {
            "id": "bye",
            "text": "Patience, walker. Even the rot takes time. [Spores drift upward in a gentle spiral.]",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
