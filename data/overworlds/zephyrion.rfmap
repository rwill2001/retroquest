  "interiorEntryX": 10,
  "interiorEntryY": 13,
  "npcs": [
    {
      "id": "npc_zeph_oren",
      "name": "Skykeeper Oren",
      "spriteName": "npcs/sage",
      "type": "QUESTGIVER",
      "defaultDialog": "The winds carry words, traveler. I am Oren, keeper of the sky-bridges. Zephyrion sends you, yes? The Laughing Gale has been expecting someone like you.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "The winds carry words, traveler. I am Oren, keeper of the sky-bridges. Zephyrion has been expecting someone like you.",
            "choices": [
              {
                "label": "Who is Zephyrion?",
                "nextNodeId": "zephyrion_lore",
                "conditions": []
              },
              {
                "label": "What is this place?",
                "nextNodeId": "island_lore",
                "conditions": []
              },
              {
                "label": "I\u0027m looking for the Key of Gales.",
                "nextNodeId": "key_quest",
                "conditions": []
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "zephyrion_lore": {
            "id": "zephyrion_lore",
            "text": "Zephyrion is the Laughing Gale � god of wind, storms, change, and freedom. He shaped these islands from clouds and lightning. Unlike the other gods, he actually enjoys existing. Finds mortality delightful, he says. Of course, his idea of \u0027help\u0027 is often... unpredictable.",
            "choices": [
              {
                "label": "Tell me more.",
                "nextNodeId": "greeting",
                "conditions": []
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "island_lore": {
            "id": "island_lore",
            "text": "The Storm Archipelago � floating islands held aloft by Zephyrion\u0027s breath. Rope bridges connect the major landmasses. The storms between them are deadly, but the lightning rods keep the settlements safe. Four towns survive up here: Windhaven, Stormspire, Galewick, and Cloudrest.",
            "choices": [
              {
                "label": "Interesting.",
                "nextNodeId": "greeting",
                "conditions": []
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "key_quest": {
            "id": "key_quest",
            "text": "The Key of Gales... crystallized lightning, humming with static. It\u0027s held in the Stormspire temple, but Zephyrion won\u0027t release it to just anyone. You\u0027ll need to prove yourself worthy. Speak to the Tempest Twins at Stormspire � they oversee the trials.",
            "choices": [
              {
                "label": "I\u0027ll head to Stormspire.",
                "nextNodeId": "farewell",
                "conditions": []
              },
              {
                "label": "Tell me about the Twins.",
                "nextNodeId": "twins_lore",
                "conditions": []
              }
            ],
            "actions": []
          },
          "twins_lore": {
            "id": "twins_lore",
            "text": "Reva and Milo � brother and sister stormcallers. Reva is precise, calculating. Milo is... reckless. Brilliant, but reckless. They don\u0027t always agree on how the trials should be run. Be careful which one you side with.",
            "choices": [
              {
                "label": "Thanks for the warning.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "May the wind be at your back, traveler. And if it\u0027s not... well, that\u0027s Zephyrion\u0027s idea of humor.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 125,
      "y": 52
    },
    {
      "id": "npc_zeph_windlass",
      "name": "Captain Windlass",
      "spriteName": "npcs/pirate",
      "type": "TOWNSFOLK",
      "defaultDialog": "Ahoy! You look like someone who doesn\u0027t belong up here. Good — neither do I.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Ahoy! Captain Windlass, at your service. Sky-pirate, smuggler, and the only person on these islands with a working ship. Well... mostly working.",
            "choices": [
              {
                "label": "You\u0027re a sky-pirate?",
                "nextNodeId": "pirate_lore",
                "conditions": []
              },
              {
                "label": "What do you smuggle?",
                "nextNodeId": "smuggling",
                "conditions": []
              },
              {
                "label": "Know anything useful?",
                "nextNodeId": "useful_info",
                "conditions": []
              },
              {
                "label": "Fair winds.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "pirate_lore": {
            "id": "pirate_lore",
            "text": "The Storm Archipelago has currents of wind between the islands that can carry a ship � if you know the routes. Most people use the rope bridges like sensible folk. I prefer the scenic route. Faster, too, if the storms cooperate.",
            "choices": [
              {
                "label": "Sounds dangerous.",
                "nextNodeId": "greeting",
                "conditions": []
              },
              {
                "label": "Fair winds.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "smuggling": {
            "id": "smuggling",
            "text": "Information, mostly. Goods between islands the temples don\u0027t want traded. People who need to disappear. Nothing that\u0027ll keep me up at night. The Stormspire priests don\u0027t approve, but Zephyrion himself? I think he finds it amusing.",
            "choices": [
              {
                "label": "Interesting.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "useful_info": {
            "id": "useful_info",
            "text": "There\u0027s an island Zephyrion forgot. Or pretends to have forgotten. Northwest of here, shrouded in permanent fog. My compass goes haywire near it. Something\u0027s there � something old. But every time I try to sail close, the wind pushes me back.",
            "choices": [
              {
                "label": "A hidden island?",
                "nextNodeId": "hidden_island",
                "conditions": []
              },
              {
                "label": "Good to know.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "hidden_island": {
            "id": "hidden_island",
            "text": "I\u0027ve been trying to reach it for years. The fog... it\u0027s not natural. It moves against the wind. Whatever\u0027s there, Zephyrion doesn\u0027t want anyone finding it. Which, naturally, makes me want to find it even more.",
            "choices": [
              {
                "label": "Maybe I can help someday.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Keep your eyes on the sky, friend. Storms come fast up here.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 170,
      "y": 140
    },
    {
      "id": "npc_zeph_weathervane",
      "name": "The Weathervane",
      "spriteName": "npcs/oracle",
      "type": "TOWNSFOLK",
      "defaultDialog": "The wind... it speaks... but not in words...",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Rain tomorrow. Sun never. The wind speaks in spirals and I... I listen. You... you are the still point. The eye of every storm. Null. Null. Null.",
            "choices": [
              {
                "label": "What do you mean, \u0027Null\u0027?",
                "nextNodeId": "null_alignment",
                "conditions": []
              },
              {
                "label": "Are you alright?",
                "nextNodeId": "condition",
                "conditions": []
              },
              {
                "label": "What do you see in my future?",
                "nextNodeId": "prophecy",
                "conditions": []
              },
              {
                "label": "I should go.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "null_alignment": {
            "id": "null_alignment",
            "text": "The seven gods each pull. Lirandel pulls toward mercy. Pyralis toward ambition. Zephyrion toward freedom. But you... you resist all pulls equally. Null Alignment � beholden to no god, claimed by none. It makes you dangerous. It makes you � necessary. The Forge Eternal cannot be relit by a partisan. Only the unaligned can touch all seven shards without being consumed.",
            "choices": [
              {
                "label": "The Forge Eternal?",
                "nextNodeId": "forge_eternal",
                "conditions": []
              },
              {
                "label": "That\u0027s unsettling.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "forge_eternal": {
            "id": "forge_eternal",
            "text": "Seven shards. Seven gods. Seven islands. The Forge that shaped the world itself, shattered in the Godswar. Each god kept a piece � Lirandel\u0027s Shard of Corruption, Pyralis\u0027s Shard of Ambition, Zephyrion\u0027s Shard of Freedom. Someone is gathering them. Someone who is not you. The countdown continues.",
            "choices": [
              {
                "label": "Who is gathering them?",
                "nextNodeId": "gatherer",
                "conditions": []
              },
              {
                "label": "I\u0027ll stop it.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "gatherer": {
            "id": "gatherer",
            "text": "I see... a figure in shadow. Not Umbryn � Umbryn IS shadow. This one WEARS it. They move between islands unseen. They have already claimed two shards. Time spirals. The storm approaches.",
            "choices": [
              {
                "label": "I need to hurry.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "condition": {
            "id": "condition",
            "text": "My mind was shattered when I touched the Eye of the Storm � Zephyrion\u0027s sacred relic. I see all weather, all winds, all possible skies. It is... too much. But in the noise, there are patterns. And you are the biggest pattern of all.",
            "choices": [
              {
                "label": "What patterns?",
                "nextNodeId": "prophecy",
                "conditions": []
              },
              {
                "label": "I\u0027m sorry.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "prophecy": {
            "id": "prophecy",
            "text": "I see seven keys. Seven doors. Seven tests. You have passed two. Five remain. The wind says you will face a choice on every island � mercy or power, order or chaos, truth or comfort. Choose carefully. The Forge remembers every decision.",
            "choices": [
              {
                "label": "I\u0027ll remember.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "The barometer falls. Storm coming. Always a storm coming.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 48,
      "y": 105
    },
    {
      "id": "npc_zeph_grik",
      "name": "Grounded Grik",
      "spriteName": "npcs/dwarf",
      "type": "QUESTGIVER",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [
        "stormcaller_blade",
        "windweave_armor",
        "gale_shield",
        "zephyr_helm"
      ],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Bah! Heights. Who decided to build a civilization in the SKY? I\u0027m Grik. Dwarf. Blacksmith. And profoundly unhappy about being this far from solid ground.",
            "choices": [
              {
                "label": "What are you doing up here?",
                "nextNodeId": "backstory",
                "conditions": []
              },
              {
                "label": "Can I see your wares?",
                "nextNodeId": "shop",
                "conditions": []
              },
              {
                "label": "I can get you lightning for your forge.",
                "nextNodeId": "forge_quest_intro",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "griks_forge_materials",
                    "value": "",
                    "amount": 0,
                    "negate": true
                  },
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "griks_forge_materials",
                    "value": "",
                    "amount": 0,
                    "negate": true
                  }
                ]
              },
              {
                "label": "How\u0027s the forge coming?",
                "nextNodeId": "forge_active",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "griks_forge_materials",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "backstory": {
            "id": "backstory",
            "text": "Exiled from Pyralis. The forge cult decided my techniques were \u0027heretical.\u0027 All I did was mix their volcanic steel with sky-metal. Made a blade that could cut through a forge golem. They didn\u0027t like that. So here I am, queasy and miserable, running a forge on a floating rock.",
            "choices": [
              {
                "label": "Their loss.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "shop": {
            "id": "shop",
            "text": "I forge with whatever I can get up here. Cloud-iron, sky-metal, and lightning when I can capture it. Not my best work, but better than anything else you\u0027ll find in the clouds.",
            "choices": [
              {
                "label": "Show me.",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "OPEN_SHOP",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "forge_quest_intro": {
            "id": "forge_quest_intro",
            "text": "Actually... I need lightning. Three Vials of Lightning to power my forge properly. The sky-metal won\u0027t temper without it. Get me three vials and I\u0027ll forge you a Zephyr Helm � finest headgear in the Archipelago.",
            "choices": [
              {
                "label": "I\u0027ll get your lightning.",
                "nextNodeId": "forge_accepted",
                "conditions": []
              },
              {
                "label": "Maybe later.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "forge_accepted": {
            "id": "forge_accepted",
            "text": "You can buy the vials from Lira in Windhaven or Pip in the plaza. Or find them in the dungeon if you\u0027re the adventuring type. Three vials. Don\u0027t shake them.",
            "choices": [
              {
                "label": "Three vials, got it.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "griks_forge_materials",
                "value": "",
                "amount": 0
              }
            ]
          },
          "forge_active": {
            "id": "forge_active",
            "text": "Still need those three Vials of Lightning. My forge is cold without them. Hurry up � this altitude is making me nauseous.",
            "choices": [
              {
                "label": "Working on it.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Bah. Don\u0027t look down on the way out. Trust me.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 55,
      "y": 48
    },
    {
      "id": "npc_zeph_sailor",
      "name": "Stranded Sailor",
      "spriteName": "npcs/pirate",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Oh thank the winds! Another living soul! I\u0027m Kessa � navigator of the Stormchaser. Or... I was, before we crashed.",
            "choices": [
              {
                "label": "What happened to your ship?",
                "nextNodeId": "crash",
                "conditions": []
              },
              {
                "label": "Are you hurt?",
                "nextNodeId": "hurt",
                "conditions": []
              },
              {
                "label": "I was sent to find you.",
                "nextNodeId": "rescue",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "stranded_sailor_rescue",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Hang in there.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "crash": {
            "id": "crash",
            "text": "We were charting the hidden island � the fog-shrouded one northwest. Got closer than anyone ever has. Then the wind just... stopped. Dead calm in the middle of a hurricane. The sails went slack, the lodestone went cold, and we dropped like a stone. Something PUSHED us away. Something that didn\u0027t want us there.",
            "choices": [
              {
                "label": "The hidden island pushed you?",
                "nextNodeId": "hidden",
                "conditions": []
              },
              {
                "label": "Can I help?",
                "nextNodeId": "hurt",
                "conditions": []
              }
            ],
            "actions": []
          },
          "hidden": {
            "id": "hidden",
            "text": "I know how it sounds. But I\u0027ve sailed these skies for ten years. Wind doesn\u0027t just stop. Something controls the air around that island. Something powerful. Windlass was right � there IS something there. And it doesn\u0027t want visitors.",
            "choices": [
              {
                "label": "That\u0027s important information.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "heard_hidden_island_crash",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "hurt": {
            "id": "hurt",
            "text": "Bruised, not broken. The wreckage gave me shelter and there\u0027s enough salvage to survive. But I can\u0027t get back across the bridge alone � the storm hawks have been circling.",
            "choices": [
              {
                "label": "I\u0027ll clear the way.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rescue": {
            "id": "rescue",
            "text": "Vael sent you? Good woman. Tell her I\u0027m alive and I\u0027ll make my way back once the hawks clear out. And tell Windlass what I said about the hidden island � she needs to know the wind barrier is real.",
            "choices": [
              {
                "label": "I\u0027ll pass the word.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "LOG_MESSAGE",
                "target": "Kessa confirms the hidden island has an unnatural wind barrier.",
                "value": "INFO",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "Thanks for coming. It\u0027s lonely out here with just the wreck and the hawks for company.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 38,
      "y": 40
    },
    {
      "id": "npc_zeph_shepherd",
      "name": "Wind Shepherd",
      "spriteName": "npcs/ranger",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Hush... watch. See the cloud wisps? Those are sky-lambs. I tend them. They drift through the vapor layers, feeding on condensation. Gentle creatures.",
            "choices": [
              {
                "label": "You herd clouds?",
                "nextNodeId": "herding",
                "conditions": []
              },
              {
                "label": "What else lives in the clouds?",
                "nextNodeId": "creatures",
                "conditions": []
              },
              {
                "label": "This is a peaceful place.",
                "nextNodeId": "peace",
                "conditions": []
              },
              {
                "label": "Goodbye.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "herding": {
            "id": "herding",
            "text": "Sounds strange, I know. But cloud-wool is valuable � it\u0027s what they weave Windweave Armor from. I shear the sky-lambs when they\u0027re thick enough, then sell the wool to Lira in Windhaven. It\u0027s a living. A quiet one.",
            "choices": [
              {
                "label": "That explains the armor.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "creatures": {
            "id": "creatures",
            "text": "Cloud fish in the deep layers, sky-lambs in the middle, and storm hawks up top. The hawks are predators � they hunt the lambs. I spend half my time chasing them off. Below everything? Storm serpents. Don\u0027t go below the cloud line.",
            "choices": [
              {
                "label": "Noted.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "peace": {
            "id": "peace",
            "text": "The Wind Garden. That\u0027s what they call this islet. The flowers here bloom sideways, following the breeze. No two days look the same. Zephyrion\u0027s one truly gentle place.",
            "choices": [
              {
                "label": "Beautiful.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Step softly. The sky-lambs spook easily.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 82,
      "y": 152
    }
  ],
