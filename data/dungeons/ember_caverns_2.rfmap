  "npcs": [
    {
      "id": "npc_ec2_ghost",
      "name": "Miner's Spirit",
      "spriteName": "npcs/oracle",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 19,
      "y": 19,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "You see me? Most cannot. I died here when the lava shifted. My bones lie beneath the throne. Don't sit on it — it remembers.",
            "choices": [
              {
                "label": "What does the throne remember?",
                "nextNodeId": "throne",
                "conditions": []
              },
              {
                "label": "What's below?",
                "nextNodeId": "below",
                "conditions": []
              },
              {
                "label": "Rest in peace.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "throne": {
            "id": "throne",
            "text": "This was Pyralis's first forge-temple. The throne weighs your ambition against your wisdom. I was found wanting. The lava took me.",
            "choices": [
              {
                "label": "The first forge-temple...",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "heard_first_forge_lore",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The spirit reveals this was Pyralis's original forge-temple.",
                "value": "INFO",
                "amount": 0
              }
            ]
          },
          "below": {
            "id": "below",
            "text": "The deepest level is a crucible. Something guards it — forged, not born. Metal feet on stone. And recently... a young man's voice. Shouting. Alive.",
            "choices": [
              {
                "label": "Aldric might be there.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "LOG_MESSAGE",
                "target": "The spirit confirms someone living is on level 3.",
                "value": "INFO",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "The mountain remembers. Walk carefully.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_ec2_ratcatcher",
      "name": "Slag Rat Catcher",
      "spriteName": "npcs/thief",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 4,
      "y": 21,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Shh! I'm hunting slag rats. Their pelts fetch good coin. How'd YOU get past the locked gate?",
            "choices": [
              {
                "label": "What locked gate?",
                "nextNodeId": "gate",
                "conditions": []
              },
              {
                "label": "Good hunting.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "gate": {
            "id": "gate",
            "text": "South corridor. Iron gate, locked solid. The forge cult sealed something behind it. You need an iron key. Whatever's behind it... the screaming comes from there. Every night.",
            "choices": [
              {
                "label": "I'll find a way through.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Keep quiet. The rats hear everything.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    }
  ],
  "townEntrances": [],
  "overworldTeleporters": [],
  "initialTileStates": {}
