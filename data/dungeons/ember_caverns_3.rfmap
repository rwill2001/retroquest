  "npcs": [
    {
      "id": "npc_ec3_aldric",
      "name": "Aldric",
      "spriteName": "npcs/blacksmith",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 24,
      "y": 7,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "You're real! I'm Aldric — Kira's apprentice. Been trapped down here for weeks. A forge golem guards the exit. It doesn't sleep.",
            "choices": [
              {
                "label": "Kira sent me to find you.",
                "nextNodeId": "kira",
                "conditions": []
              },
              {
                "label": "What did you find?",
                "nextNodeId": "discovery",
                "conditions": []
              },
              {
                "label": "I'll deal with the golem.",
                "nextNodeId": "golem",
                "conditions": []
              }
            ],
            "actions": []
          },
          "kira": {
            "id": "kira",
            "text": "Kira! Is she alright? I left without telling anyone — stupid, I know. But I found a reference to Pyralis's original forge in the old records. I had to see it.",
            "choices": [
              {
                "label": "What did you find?",
                "nextNodeId": "discovery",
                "conditions": []
              }
            ],
            "actions": []
          },
          "discovery": {
            "id": "discovery",
            "text": "The altar in the central chamber — it's Pyralis's first forge anvil. The lava flows in designed channels. This is where the Shard of Ambition was forged. I could feel it humming through the stone.",
            "choices": [
              {
                "label": "That's incredible.",
                "nextNodeId": "escape",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "aldric_found",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Aldric reveals the boss altar is Pyralis's original forge anvil!",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "escape": {
            "id": "escape",
            "text": "The golem patrols near the altar. If you defeat it, I can slip past. Tell Kira I'm coming home.",
            "choices": [
              {
                "label": "I'll clear the way.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "golem": {
            "id": "golem",
            "text": "It's massive — twice the normal size. Ancient. The lava in its joints glows white. I think it was built to guard Pyralis's creation point.",
            "choices": [
              {
                "label": "I'll take it on.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Be careful. And... thank you. I was starting to think no one was coming.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    }
  ],
  "townEntrances": [],
  "overworldTeleporters": [],
  "initialTileStates": {}
}