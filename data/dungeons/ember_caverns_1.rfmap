  "npcs": [
    {
      "id": "npc_ec1_guard",
      "name": "Wounded Forge Guard",
      "spriteName": "npcs/knight",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 19,
      "y": 7,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Ugh... careful. I'm Varn, Forge Guard. Got separated from my patrol when the slag beasts swarmed. Been holed up by this fountain for two days. The water keeps me alive, but I can't fight my way out alone.",
            "choices": [
              {
                "label": "What's deeper in these caves?",
                "nextNodeId": "deeper",
                "conditions": []
              },
              {
                "label": "I'm looking for a missing forger named Aldric.",
                "nextNodeId": "aldric",
                "conditions": []
              },
              {
                "label": "Hang tight. I'll clear the way.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "deeper": {
            "id": "deeper",
            "text": "Below this level, the caves get hot. Lava seeps through the walls. There's a throne room on the second level — something ancient sits there. And below that... I heard screaming. Not monster screaming. Human screaming. Someone's alive down there.",
            "choices": [
              {
                "label": "Human screaming?",
                "nextNodeId": "aldric",
                "conditions": []
              },
              {
                "label": "I'll investigate.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "aldric": {
            "id": "aldric",
            "text": "Aldric? Kira's apprentice? I saw him! He was heading to the third level, muttering about finding something alive in the deep slag. That was before the beasts cut me off. If he's still down there... he's either very brave or very dead.",
            "choices": [
              {
                "label": "I'll find him.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "LOG_MESSAGE",
                "target": "The wounded guard saw Aldric heading to level 3.",
                "value": "INFO",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "Pyralis keep you. And... if you find any healing potions down there, I wouldn't say no.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_ec1_prospector",
      "name": "Old Prospector",
      "spriteName": "npcs/old_woman",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 5,
      "y": 26,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Don't mind me, just checking the veins. Name's Greta. Been mining these caves since before the forge cult moved in. The obsidian here is the finest on the island — worth the risk.",
            "choices": [
              {
                "label": "Isn't it dangerous down here?",
                "nextNodeId": "danger",
                "conditions": []
              },
              {
                "label": "What do you know about these caves?",
                "nextNodeId": "caves",
                "conditions": []
              },
              {
                "label": "Safe mining.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "danger": {
            "id": "danger",
            "text": "Ha! Everything on this island is dangerous. The lava, the beasts, the forge cult's golems. But obsidian pays well, and I know these tunnels better than anyone. The slag beasts mostly stay on the lower levels. Mostly.",
            "choices": [
              {
                "label": "Good luck.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "caves": {
            "id": "caves",
            "text": "Three levels deep. First level is natural caves — carved by lava flows ages ago. Second level has old ruins — someone built down here before the forge cult. Pillars, a throne, strange carvings. Third level... I don't go there. The air itself burns, and something growls in the dark.",
            "choices": [
              {
                "label": "Ruins? Who built them?",
                "nextNodeId": "ruins",
                "conditions": []
              },
              {
                "label": "Thanks for the warning.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "ruins": {
            "id": "ruins",
            "text": "Older than the forge cult. Older than Pyralis's temples. The carvings show a forge — a massive one, built into the mountain itself. Some say it's where Pyralis first shaped weapons from the world's molten heart. The Emberpriest would kill to know about it. I keep my mouth shut.",
            "choices": [
              {
                "label": "Your secret's safe.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "heard_ancient_forge_ruins",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "Watch the lava flows. They shift when you're not looking.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    }
  ],
  "townEntrances": [],
  "overworldTeleporters": [],
  "initialTileStates": {}
}