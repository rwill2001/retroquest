  "interiorEntryX": 9,
  "interiorEntryY": 17,
  "npcs": [
    {
      "id": "npc_echo_point_witness",
      "name": "The Last Witness",
      "spriteName": "npcs/townsman",
      "type": "QUESTGIVER",
      "defaultDialog": "I am the Last Witness. I have watched this archive since before the Shattering.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "I am the Last Witness. I have watched this archive since before the Shattering. Few come here. Fewer still are worthy of what lies beyond the gate.",
            "choices": [
              {
                "label": "I seek entry to the Archive.",
                "nextNodeId": "first_visit",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "archive_access",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I bring evidence of the Eighth Dream.",
                "nextNodeId": "eighth_dream",
                "conditions": [
                  {
                    "type": "FLAG_EQUALS",
                    "target": "eighth_dream_ready",
                    "value": "true",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "What awaits me in the Archive?",
                "nextNodeId": "trial_info",
                "conditions": [
                  {
                    "type": "FLAG_EQUALS",
                    "target": "archive_access",
                    "value": "true",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "umbryn_trial_accepted",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Umbryn tested me. I remember all of it.",
                "nextNodeId": "trial_done",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "umbryn_trial",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I carry the weight of knowing.",
                "nextNodeId": "all_done",
                "conditions": [
                  {
                    "type": "FLAG_EQUALS",
                    "target": "eighth_dream_complete",
                    "value": "true",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "first_visit": {
            "id": "first_visit",
            "text": "The Archive does not open for the curious. It opens for those who have suffered, who have lost, and who continue forward despite it. Tell me — what have you lost?",
            "choices": [
              {
                "label": "I have lost companions to the dangers of this world.",
                "nextNodeId": "loss_check",
                "conditions": [
                  {
                    "type": "PLAYER_LEVEL",
                    "target": "",
                    "value": "",
                    "amount": 20,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I have lost nothing.",
                "nextNodeId": "not_ready",
                "conditions": []
              }
            ],
            "actions": []
          },
          "loss_check": {
            "id": "loss_check",
            "text": "Your scars speak truth. The Archive recognizes those who have endured. Take this key — it will open the iron gate to the north. What waits beyond is Umbryn's domain.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_ITEM",
                "target": "archive_key",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "archive_access",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Archive Key received. The way is open.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "not_ready": {
            "id": "not_ready",
            "text": "Then you are not ready. Return when you have.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "eighth_dream": {
            "id": "eighth_dream",
            "text": "You bring evidence of the Eighth Dream? ...Hope. Yes. I remember now. Umbryn locked this memory away because it was the one he could not bear. The dream that even death could be undone — not through remembrance, but through forgiveness.",
            "choices": [],
            "actions": [
              {
                "type": "COMPLETE_QUEST",
                "target": "eighth_dream",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "eighth_dream_complete",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The Eighth Dream is revealed. The Last Witness remembers.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "trial_done": {
            "id": "trial_done",
            "text": "You came back up the stairs with your own name still on you. Grief Incarnate takes most of them. [The Last Witness inclines their head, slowly.] The Archive has a new witness. I am no longer the last.",
            "choices": [
              {
                "label": "Someone should be left to remember.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "trial_info": {
            "id": "trial_info",
            "text": "Umbryn waits in the deepest sanctum. He will test you. Not your strength — your memory. He wants to know if you are worthy of carrying the truths the Archive preserves. Steel yourself, traveler.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "umbryn_trial",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "umbryn_trial_accepted",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: Umbryn's Trial",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "all_done": {
            "id": "all_done",
            "text": "You carry the weight of knowing. May it serve you better than it served us.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "The Archive remembers all who enter. Even those who do not return.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 10,
      "y": 8
    },
    {
      "id": "npc_echo_point_iris",
      "name": "Lorekeeper Iris",
      "spriteName": "npcs/townsman",
      "defaultDialog": "The Archive preserves not just memory but knowledge.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "The Archive preserves not just memory but knowledge. I can share what I've learned, if you're willing to listen.",
            "choices": [
              {
                "label": "Teach me what you know.",
                "nextNodeId": "teach",
                "conditions": []
              },
              {
                "label": "Tell me about Umbryn.",
