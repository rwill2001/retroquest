    {
      "id": "npc_forge_keep_brax",
      "name": "Arena Master Brax",
      "spriteName": "npcs/guard",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 14,
      "y": 18,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Welcome to the Forge Arena, warrior! We've got jousting, axe throwing, and anvil striking. Care to test your mettle?",
            "choices": [
              {
                "label": "Show me the games!",
                "nextNodeId": "enter_arena"
              },
              {
                "label": "What games do you have?",
                "nextNodeId": "explain"
              },
              {
                "label": "Not today.",
                "nextNodeId": "farewell"
              }
            ],
            "actions": []
          },
          "explain": {
            "id": "explain",
            "text": "Three events, each a test of skill! Jousting tests your reflexes and strength. Axe throwing demands precision and a steady hand. Anvil striking is pure power and endurance. Place your bets and see how you measure up!",
            "choices": [
              {
                "label": "I'm ready!",
                "nextNodeId": "enter_arena"
              },
              {
                "label": "Maybe later.",
                "nextNodeId": "farewell"
              }
            ],
            "actions": []
          },
          "enter_arena": {
            "id": "enter_arena",
            "text": "Step right up! May your strikes ring true!",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_ARENA",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "Come back when you're feeling brave!",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_forge_keep_rest",
      "name": "Acolyte Bren",
      "spriteName": "npcs/townsman",
      "type": "INNKEEPER",
      "defaultDialog": "The forge never sleeps, but you may.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 20,
      "y": 18,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "[A young acolyte tends a sleeping alcove near the forge warmth.] The Keep offers rest to those who serve Pyralis. The heat of the forges keeps the chill away. Need a bed?",
            "choices": [
              {
                "label": "I'd like to rest. (Full heal, 25g)",
                "nextNodeId": "rest",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "value": "",
                    "amount": 25
                  }
                ]
              },
              {
                "label": "What's it like living in a forge?",
                "nextNodeId": "forge_life",
                "conditions": []
              },
              {
                "label": "No thanks.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rest": {
            "id": "rest",
            "text": "The forge-heat will mend what ails you. Rest well.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -25
              },
              {
                "type": "HEAL_PLAYER",
                "target": "",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The warmth of Pyralis's forge mends your wounds. Fully restored.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "forge_life": {
            "id": "forge_life",
            "text": "Hot. Always hot. You get used to the glow, the hammer-song, the smell of molten metal. Some nights the lava channels sing — a deep hum that vibrates in your bones. Pyralis speaks through the forge. If you listen, you can hear his ambition.",
            "choices": [
              {
                "label": "What does he want?",
                "nextNodeId": "want",
                "conditions": []
              }
            ],
            "actions": []
          },
          "want": {
            "id": "want",
            "text": "To make everything stronger. Harder. More perfect. He doesn't understand that some things are beautiful because they're fragile.",
            "choices": [
              {
                "label": "Wise words for an acolyte.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "May the forge light your path.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_forge_keep_armorer",
      "name": "Forge Armorer Thul",
      "spriteName": "npcs/townsman",
      "type": "SHOPKEEPER",
      "defaultDialog": "Pyralis-forged steel. Nothing finer.",
      "questCompleteDialog": "",
      "shopItemIds": [
        "healing_potion",
        "greater_healing",
        "obsidian_blade",
        "forged_steel_plate",
        "ember_shield",
        "pyralis_fire_potion",
        "hard_bread",
        "dried_fish",
        "travel_rations"
      ],
      "x": 10,
      "y": 19,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "[A broad-chested smith examines a glowing blade fresh from the forge.] Pyralis-forged steel — tempered in volcanic heat, quenched in lava. You won't find better on any island. Buying?",
            "choices": [
              {
                "label": "Show me your work.",
                "nextNodeId": "shop",
                "conditions": []
              },
              {
                "label": "How is Pyralis steel different?",
                "nextNodeId": "steel",
                "conditions": []
              },
              {
                "label": "Just looking.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "shop": {
            "id": "shop",
            "text": "Every piece forged by hand. Take your pick.",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_SHOP",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "steel": {
            "id": "steel",
            "text": "The volcanic heat reaches temperatures no normal forge can match. The metal becomes almost alive — it remembers the shape you hammered it into and resists being bent back. Pyralis's blessing, some say. I say it's just good metallurgy.",
            "choices": [
              {
                "label": "Let me see your inventory.",
                "nextNodeId": "shop",
                "conditions": []
              },
              {
                "label": "Interesting.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Steel and fire, traveler.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    }
