        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "[A monk in herb-stained robes sorts bundles of glowing plants.] I grow what the Garden Tender harvests and brew what Healer Alis prescribes. Potions, salves, tinctures — the sky provides, and I distill. Need something?",
            "choices": [
