            ]
          },
          "grows": {
            "id": "grows",
            "text": "Things you'd never find on solid ground. Cloudpetal, which only opens during lightning storms. Wind-root, which grows sideways following the breeze. And sky-moss — it absorbs lightning and glows at night. The Garden Tender is the real expert. I just boil things.",
            "choices": [
              {
                "label": "Let me see your stock.",
