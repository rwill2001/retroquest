          "about": {
            "id": "about",
            "text": "Cloudrest floats on the highest cloud in the Archipelago. The monks came here seeking silence — ironic, given the wind. But they say the wind IS silence, if you listen properly. I don't understand it, but I've seen monks stand in a hurricane without flinching. So perhaps they're onto something.",
            "choices": [
              {
                "label": "Monks who stand in hurricanes. Impressive.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "May the winds carry you gently.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
