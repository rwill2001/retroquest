                "value": "",
                "amount": 10
              },
              {
                "type": "SET_FLAG",
                "target": "borrowed_grief_settled",
                "value": "shared",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
