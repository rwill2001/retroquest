    },
    {
      "id": "npc_cinderport_barmaid",
      "name": "Ember",
      "spriteName": "npcs/barmaid",
      "type": "TOWNSFOLK",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Welcome, love! What can I get ya? The ale's fresh today.",
            "choices": [
              {
                "label": "I'll have an ale. (3 gold)",
                "nextNodeId": "serve_ale",
                "conditions": [
                  {
