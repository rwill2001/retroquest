              }
            ]
          },
          "no_gold": {
            "id": "no_gold",
            "text": "Looks like your purse is a bit light, dear. Come back when you've got the coin.",
            "choices": [
              {
                "label": "I'll be back.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rumor_1": {
            "id": "rumor_1",
            "text": "The forge fires have been burning hotter than usual. The smiths say the mountain's waking up, but what do they know?",
            "choices": [
              {
                "label": "Interesting...",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "cinderport_rumor_1",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "rumor_2": {
            "id": "rumor_2",
            "text": "Sailors refuse to dock at the western pier anymore. Say something watches from below the water. Something big.",
            "choices": [
              {
                "label": "Interesting...",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "cinderport_rumor_2",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "rumor_3": {
            "id": "rumor_3",
            "text": "The Emberpriest's been chanting day and night in the temple. Last time that happened, the ground shook for a week.",
            "choices": [
