  "npcs": [
    {
      "id": "npc_cinderport_voss",
      "name": "Harbor Captain Voss",
      "spriteName": "npcs/townsman",
      "type": "QUESTGIVER",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Welcome to Cinderport, stranger. I'm Captain Voss — I run the harbor. Not many ships come through anymore, not since the forge went quiet.",
            "choices": [
              {
                "label": "What happened to the forge?",
                "nextNodeId": "forge_info",
                "conditions": []
              },
              {
                "label": "I'm looking for work.",
                "nextNodeId": "work",
                "conditions": []
              },
              {
                "label": "I can handle a dungeon. Got anything dangerous?",
                "nextNodeId": "dungeon_quest_intro",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "deep_dungeon_expedition",
                    "value": "",
                    "amount": 0,
                    "negate": true
                  },
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "deep_dungeon_expedition",
                    "value": "",
                    "amount": 0,
                    "negate": true
                  }
                ]
              },
              {
                "label": "About that dungeon expedition...",
                "nextNodeId": "dungeon_quest_active",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "deep_dungeon_expedition",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Just passing through.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "dungeon_quest_intro": {
            "id": "dungeon_quest_intro",
            "text": "Dangerous? The volcanic tunnels beneath this island go deeper than anyone's mapped. I need someone to descend to the 5th level and report back what's down there. The last man I sent... didn't come back.",
            "choices": [
              {
                "label": "I'll do it.",
                "nextNodeId": "dungeon_quest_accepted",
                "conditions": []
              },
              {
                "label": "Maybe later.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "dungeon_quest_accepted": {
            "id": "dungeon_quest_accepted",
            "text": "Good. The dungeon entrance is on the overworld — look for the stone archway. Get to level 5, take note of what you see, and get out alive. That's the job.",
            "choices": [
              {
                "label": "Consider it done.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "deep_dungeon_expedition",
                "value": "",
                "amount": 0
              }
            ]
          },
          "dungeon_quest_active": {
            "id": "dungeon_quest_active",
            "text": "Level 5, remember. Don't come back until you've been that deep. And try not to die — I hate paperwork.",
            "choices": [
              {
                "label": "I'm working on it.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "forge_info": {
            "id": "forge_info",
            "text": "The old forgemaster vanished weeks ago. Kira's been keeping things running, but she's stretched thin. Without his expertise, the obsidian blades are losing their edge.",
            "choices": [
              {
                "label": "Where did he go?",
                "nextNodeId": "bribe_hint",
                "conditions": []
              },
              {
                "label": "I'll talk to Kira.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "bribe_hint": {
            "id": "bribe_hint",
            "text": "Some say he went into the volcanic caves east of town. Others say he was taken. A dockhand saw torchlight near the old lava tubes... but he won't talk unless you grease his palm. Try asking Kira — she knew the old man best.",
            "choices": [
              {
                "label": "Thanks for the tip.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "work": {
            "id": "work",
            "text": "Work? Ha! Plenty of trouble to go around. Talk to Kira at the forge — she's been asking everyone who docks here for help. Something about a missing person.",
            "choices": [
              {
                "label": "I'll check it out.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Watch yourself out there. The ground's not as stable as it looks on this island.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 6,
      "y": 10
    },
    {
      "id": "npc_cinderport_kira",
      "name": "Forgemaster Kira",
      "spriteName": "npcs/shopkeeper",
      "type": "SHOPKEEPER",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [
        "obsidian_blade",
        "forged_steel_plate",
        "ember_shield",
        "healing_potion",
        "pyralis_fire_potion",
        "hard_bread",
        "dried_fish",
        "travel_rations"
      ],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "The forge burns day and night. I'm Kira — I keep Cinderport armed and armored. What brings you to my shop?",
            "choices": [
              {
                "label": "I'd like to browse your wares.",
                "nextNodeId": "shop",
                "conditions": []
              },
              {
                "label": "I heard about a missing forger.",
                "nextNodeId": "quest_intro",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_missing_forger",
                    "value": "",
                    "amount": 0,
                    "negate": true
                  },
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "the_missing_forger",
                    "value": "",
                    "amount": 0,
                    "negate": true
                  }
                ]
              },
              {
                "label": "Any news about the missing forger?",
                "nextNodeId": "quest_active",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_missing_forger",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Tell me about this island.",
                "nextNodeId": "lore",
                "conditions": []
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "shop": {
            "id": "shop",
            "text": "Take a look. Everything's forged right here in Cinderport's own fires.",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_SHOP",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "quest_intro": {
            "id": "quest_intro",
            "text": "My mentor, Master Aldric, disappeared three weeks ago. He went to harvest obsidian from the volcanic caves and never returned. I've been running the forge alone, but I can't keep this up. Please — find him and bring him back.",
            "choices": [
              {
                "label": "I'll find him.",
                "nextNodeId": "quest_accepted",
                "conditions": []
              },
              {
                "label": "Not right now.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "quest_accepted": {
            "id": "quest_accepted",
            "text": "Thank the flames. The volcanic caves are east of town — be careful, the tunnels shift with the heat. Aldric always carried a firesteel pendant. If you find it, you'll know you're on his trail.",
            "choices": [
              {
                "label": "I'll head out.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "the_missing_forger",
                "value": "",
                "amount": 0
              }
            ]
          },
          "quest_active": {
            "id": "quest_active",
            "text": "No word yet. The volcanic caves are dangerous — please hurry. Every day without Aldric, the forge grows colder.",
            "choices": [
              {
                "label": "I'm working on it.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "lore": {
            "id": "lore",
            "text": "This island was born from fire. Pyralis's breath, the old folk say. The volcano hasn't erupted in a century, but the earth still rumbles. The obsidian here is the finest in the realm — harder than steel when properly forged.",
            "choices": [
              {
                "label": "Interesting. Let me see your shop.",
                "nextNodeId": "shop",
                "conditions": []
              },
              {
                "label": "Thanks for the history.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "May the forge's fire light your path.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 17,
      "y": 10
    },
    {
      "id": "npc_cinderport_innkeeper",
      "name": "Cinderport Innkeeper",
      "spriteName": "npcs/innkeeper",
      "type": "INNKEEPER",
      "defaultDialog": "",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Welcome, weary traveler. The beds are simple but the walls are thick — keeps out the heat and the noise. What'll it be?",
            "choices": [
              {
                "label": "I'd like to rest.",
                "nextNodeId": "rest",
                "conditions": []
              },
              {
                "label": "Any local gossip?",
                "nextNodeId": "gossip",
                "conditions": []
              },
              {
                "label": "Nothing, thanks.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rest": {
            "id": "rest",
            "text": "Sleep well. The forge's glow will keep the dark things at bay.",
            "choices": [],
            "actions": [
              {
                "type": "HEAL_PLAYER",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "gossip": {
            "id": "gossip",
            "text": "Strange things happening lately. Tremors in the night, more than usual. Some miners swear they've seen shapes moving in the lava tubes. And old Aldric — the master forger — just vanished. Kira's worried sick about him.",
            "choices": [
              {
                "label": "Sounds dangerous. I'll rest up first.",
                "nextNodeId": "rest",
                "conditions": []
              },
              {
                "label": "Thanks for the warning.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Door's always open. Well, mostly.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 24,
      "y": 10
    },
    {
      "id": "npc_cinderport_bryn",
      "name": "Merchant Bryn",
      "spriteName": "npcs/shopkeeper",
