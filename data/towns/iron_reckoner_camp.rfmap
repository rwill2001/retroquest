                "value": "",
                "amount": 10
              },
              {
                "type": "ADD_FAVOR",
                "target": "LIRANDEL",
                "value": "",
                "amount": 10
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Sten walks away from a six-hundred-year custom. Bellorak feels the knot go loose.",
                "value": "WARN",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "oath_take": {
            "id": "oath_take",
            "text": "[Witness to witness. It is four words and a grip and it takes less time than a handshake normally does.]\n[Something settles behind your sternum, next to the scar, and starts pulling south-east.]\nThere. That is it. That is what I have had.\n...It is worse than I could describe and I want you to know I did describe it honestly and you took it anyway, and that is the only decent thing that has happened to me in eleven years.\nGo carefully. It will try to make things fit. It will look at every Gold Guard captain you pass and tell you that one is close enough. It is very patient and it is not clever, and the not-clever part is what makes it dangerous.\nAnd if you ever find yourself at the Pit — the oath knows the Pit. It was made there. It will pull very hard and you will want to call that a sign.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "sten_oath_settled",
                "value": "taken",
                "amount": 0
