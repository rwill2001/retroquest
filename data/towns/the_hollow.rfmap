    {
      "id": "npc_hollow_nameless3",
      "name": "Nameless Three",
      "spriteName": "npcs/townsman",
      "type": "LORE",
      "defaultDialog": "The music. I remember the music. But not the song.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 16,
      "y": 13,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "The music. I remember the music. But not the song.",
            "choices": [
              {
                "label": "Was the song called Hope?",
                "nextNodeId": "give_evidence",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "eighth_dream",
                    "value": "",
                    "amount": 0
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "eighth_dream_evidence_given",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Listen a while, then go.]",
                "nextNodeId": "leave",
                "conditions": []
              }
            ],
            "actions": []
          },
          "give_evidence": {
            "id": "give_evidence",
            "text": "[He stops humming. For one moment his eyes are entirely present.] Hope. Yes. There were eight. The other seven ate the eighth so she could not warn anyone. I wrote it down before I forgot how. Here — take it, take it, I do not want to hold it when it goes.",
            "choices": [
              {
                "label": "You held it long enough. Thank you.",
                "nextNodeId": "leave",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_ITEM",
                "target": "eighth_dream_evidence",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "eighth_dream_evidence_given",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The nameless man presses a folded scrap into your hand. Evidence of the Eighth Dream.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "leave": {
            "id": "leave",
            "text": "The music. I remember the music. But not the song.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_hollow_well",
      "name": "The Well of Names",
      "spriteName": "npcs/oracle",
      "type": "TOWNSFOLK",
      "defaultDialog": "[A hole in the floor of the world. It is saying names.]",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "[A round shaft cut through the floor of The Hollow, ringed in worn stone. It is not empty and it is not deep. It is saying names, one after another, at the speed of a person reading a list they have read many times.]\n— Aldric. Veyla. Tomas. Corran. Sesh. Oleander. Ossa. Varsa. —\n[It does not stop for you. It has never stopped for anybody.]",
            "choices": [
              {
                "label": "[Listen for your own name.]",
                "nextNodeId": "well_listen",
                "conditions": []
              },
              {
                "label": "[Sable said she would project Seraphine's echo here.]",
                "nextNodeId": "well_echo",
                "conditions": [
                  {
                    "type": "FLAG_EQUALS",
                    "target": "seraphine_echo_ready",
                    "value": "true",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "seraphine_echo_heard",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Ask it what it wants.]",
                "nextNodeId": "well_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "well_quest_offered",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Active] The knights are still standing.",
                "nextNodeId": "well_progress",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_well_of_names",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Complete] They are relieved.",
                "nextNodeId": "well_done",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "the_well_of_names",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "well_relieved",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Step back.]",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "well_listen": {
            "id": "well_listen",
            "text": "[You wait through four hundred names. Yours is not among them, and neither is the scar on your chest, and neither is anything about you at all.]\n[The Well is a list of everyone Umbryn has ever been able to see.]",
            "choices": [
              {
                "label": "[Step back.]",
                "nextNodeId": "farewell",
