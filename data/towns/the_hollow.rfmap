                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Say nothing.]",
                "nextNodeId": "leave",
                "conditions": []
              }
            ],
            "actions": []
          },
          "give_crystal": {
            "id": "give_crystal",
            "text": "In... stone? [He turns the crystal over twice, then pushes it at you, hard, like it burns.] You keep. You keep. I had a... who?",
            "choices": [
              {
                "label": "Someone who will be remembered.",
                "nextNodeId": "leave",
