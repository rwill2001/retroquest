    {
      "id": "npc_hollow_nameless2",
      "name": "Nameless Two",
      "spriteName": "npcs/townsman",
      "type": "LORE",
      "defaultDialog": "Name... had a... who?",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 18,
      "y": 11,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Name... had a... who?",
            "choices": [
              {
                "label": "You had a name. It is in that stone.",
                "nextNodeId": "give_crystal",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "fading_names",
                    "value": "",
                    "amount": 0
                  },
                  {
                    "type": "FLAG_NOT_SET",
