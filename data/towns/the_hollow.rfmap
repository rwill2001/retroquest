  "npcs": [
    {
      "id": "npc_hollow_vel",
      "name": "Mourner Vel",
      "spriteName": "npcs/townsman",
      "type": "QUESTGIVER",
      "defaultDialog": "You can speak? You still have a name? Then you are not yet lost.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 5,
      "y": 9,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "You can speak? You still have a name? Then you are not yet lost.",
            "choices": [
              {
                "label": "What is this place?",
                "nextNodeId": "no_quest",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "eighth_dream_accepted",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Quest Active] I found something.",
                "nextNodeId": "quest_has_evidence",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "eighth_dream",
                    "value": "",
                    "amount": 0
                  },
                  {
                    "type": "HAS_ITEM",
                    "target": "eighth_dream_evidence",
                    "value": "",
                    "amount": 1
                  }
                ]
              },
              {
                "label": "[Quest Active] Still searching.",
                "nextNodeId": "quest_no_evidence",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "eighth_dream",
                    "value": "",
                    "amount": 0
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "eighth_dream_ready",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Quest Done] About the eighth dream...",
                "nextNodeId": "quest_done",
                "conditions": [
                  {
                    "type": "FLAG_EQUALS",
                    "target": "eighth_dream_ready",
                    "value": "true",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "What is a Hollow One?",
                "nextNodeId": "unmourned_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "unmourned_offered",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Active] Still out among them.",
                "nextNodeId": "unmourned_progress",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_unmourned",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Complete] Five are at rest.",
                "nextNodeId": "unmourned_done",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "the_unmourned",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "unmourned_recorded",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Keeper Mord wants a day on which nothing happened.",
                "nextNodeId": "vel_day",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_archive_of_small_things",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "day_vel",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Farewell.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "no_quest": {
            "id": "no_quest",
            "text": "The Last Witness speaks of an eighth dream — one the other seven consumed. I have seen fragments in the Nameless' memories. Will you investigate?",
            "choices": [
              {
                "label": "I will look into it.",
                "nextNodeId": "quest_accept",
                "conditions": []
              },
              {
                "label": "Not now.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "quest_accept": {
            "id": "quest_accept",
            "text": "Then go and sit with the Nameless. What the Archive lost, they still carry — badly, in pieces. One of them is holding it and does not know the word for it.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "eighth_dream",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "eighth_dream_accepted",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: The Eighth Dream",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "quest_has_evidence": {
            "id": "quest_has_evidence",
            "text": "You found it. Hope. The dream the gods destroyed. Take this to the Last Witness at Echo Point.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "eighth_dream_ready",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Vel recognizes the evidence. Bring it to the Last Witness at Echo Point.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "quest_no_evidence": {
            "id": "quest_no_evidence",
            "text": "Sit with the Nameless. Do not ask them questions. Wait until one of them offers.",
            "choices": [
              {
                "label": "I'll keep looking.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "quest_done": {
            "id": "quest_done",
            "text": "Hope was consumed but not destroyed. It lives in fragments, in every act of kindness.",
            "choices": [
              {
                "label": "A comforting thought.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Remember your name. That is all any of us can do.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "unmourned_offer": {
            "id": "unmourned_offer",
            "text": "The next thing after these three. [She does not look at the Nameless when she says it, which is its own kind of tenderness.]\nA Nameless has lost the word. A Hollow One has lost the person. Same body, walking, and there is nobody at all inside it — Umbryn dropped the file and the file was the tenant.\nThey are out in the trenches by the hundred and nobody will go near them, and so nobody has ever said a word over one, and they have been not-buried for four hundred years.\nI cannot fight. I am sixty and I have wept myself down to nothing. Go out and put five of them down, and I will do the only half of a funeral I am able to do.",
            "choices": [
              {
                "label": "I'll do it.",
                "nextNodeId": "unmourned_accept",
                "conditions": []
              },
              {
                "label": "That is a hard thing to ask.",
                "nextNodeId": "unmourned_accept",
                "conditions": []
              }
            ],
            "actions": []
          },
          "unmourned_accept": {
            "id": "unmourned_accept",
            "text": "It is the only thing left to ask. I stopped having the good asks a long time ago.\nFive. And come back — that is the part that matters. Anyone can do the killing.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "the_unmourned",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "unmourned_offered",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: The Unmourned",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "unmourned_progress": {
            "id": "unmourned_progress",
            "text": "Five. And do not look for anything in their faces on the way down. There is nothing there and looking only costs you.",
            "choices": [
              {
                "label": "I know.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "unmourned_done": {
            "id": "unmourned_done",
            "text": "[She has the book open before you finish speaking.]\nRight. Now. There is a decision in this and I am going to make you make it, because I have made it wrong twice.\nI can write them down as gone. That is a record, it is true, and Umbryn will take it, and it will be in the Archive forever: five went, on this day, and were witnessed.\nOr I can write down what they were before he dropped them. Guesses. A build, a gait, the way one of them still turned left at a corner that has not been there in a century. Not true, most of it. Not a record at all.\nOne of those is honest. The other one is a funeral.",
            "choices": [
              {
                "label": "Write them down as gone. Let it be true.",
                "nextNodeId": "unmourned_gone",
                "conditions": []
              },
              {
                "label": "Write down what they were. Let it be a funeral.",
                "nextNodeId": "unmourned_people",
                "conditions": []
              }
            ],
            "actions": []
          },
          "unmourned_gone": {
            "id": "unmourned_gone",
            "text": "[She writes five lines. It takes under a minute. She is very good at this and that is the saddest fact in The Hollow.]\nGone. Witnessed. Filed.\nHe will take that. He takes anything that is true; it is the only appetite he has left.\nThank you. That is five fewer holes in the world that nobody could name.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "unmourned_recorded",
                "value": "gone",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "UMBRYN",
                "value": "",
                "amount": 15
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Five deaths enter the record, exactly and truly.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "unmourned_people": {
            "id": "unmourned_people",
            "text": "[She writes for a very long time, and some of it is obviously invented, and she does not pretend otherwise.]\nOne of them was tall and stooped and had been a tall stooped man for so long that the walking remembered it after he stopped. One of them still turned left at a corner. One of them was carrying something.\nNone of that will survive an archivist. It is not evidence. It will be struck out inside a year.\nBut it was said. Out loud, by a person, about a person. That is what the eighth dream was, before they ate her — not that we would be remembered accurately. That we would be remembered kindly.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "unmourned_recorded",
                "value": "people",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "UMBRYN",
                "value": "",
                "amount": 5
              },
              {
                "type": "ADD_FAVOR",
                "target": "LIRANDEL",
                "value": "",
                "amount": 10
              },
              {
                "type": "ADD_FAVOR",
                "target": "SYLVANDAR",
                "value": "",
                "amount": 5
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Vel writes down five people instead of five deaths.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "vel_day": {
            "id": "vel_day",
            "text": "Mord. [The first time you have seen her look amused.] Of course it is Mord. He has been arguing that at me across a counter for twenty years and I have been too busy to concede it.\nHe is right, though. I keep the worst day of four hundred people in my head and not one good afternoon, and I chose that, and I have called it devotion.\n[She thinks.]\nThe day before I came to The Hollow. I did nothing. I sat in a doorway in Dusthaven with a cup of something and watched a man fail to control a handcart for the better part of an hour. I laughed until I had to stop.\nI have not thought about it in thirty-one years and it was there the whole time, filed under nothing.\n[She writes it down, and her hand is much steadier than it is when she writes the other kind.]\nTell him he has won the argument. Tell him it took a stranger.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_ITEM",
                "target": "ordinary_day",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "day_vel",
                "value": "true",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "UMBRYN",
                "value": "",
                "amount": 5
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
