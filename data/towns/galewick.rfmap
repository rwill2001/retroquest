    {
      "id": "npc_gw_skygames",
      "name": "Gusty",
      "spriteName": "npcs/townsman",
      "type": "TOWNSFOLK",
      "defaultDialog": "Care for a game? The wind is perfect today!",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Ha! Another brave soul on the docks! I'm Gusty -- purveyor of the finest sky games in the Archipelago.\n\nWe've got three ways to test your mettle against the wind. Care to play?",
            "choices": [
              {
                "label": "Show me what you've got!",
                "nextNodeId": "play"
              },
              {
                "label": "What games do you have?",
                "nextNodeId": "explain"
              },
              {
                "label": "Not right now.",
                "nextNodeId": "farewell"
              }
            ]
          },
          "explain": {
            "id": "explain",
            "text": "Three games, each testing a different gift of the wind!\n\nWindchime Symphony -- repeat the wind's melody from memory. Gets longer each round.\n\nGust Glider -- glide through the storm! Dodge clouds and lightning, collect gold rings. Cash out or keep flying for bigger prizes.\n\nStorm Rider -- dodge lightning and collect crystals while riding the gale. Survive as long as you can!",
            "choices": [
              {
                "label": "Let's play!",
                "nextNodeId": "play"
              },
              {
                "label": "Maybe later.",
                "nextNodeId": "farewell"
              }
            ]
          },
          "play": {
            "id": "play",
            "text": "That's the spirit! Step right up!",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_SKY_GAMES",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "The wind waits for no one -- but it'll still be here when you're ready! Ha!",
            "choices": []
          }
        }
      },
      "x": 14,
      "y": 16
    }
  ],
