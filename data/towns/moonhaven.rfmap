          "no_gold": {
            "id": "no_gold",
            "text": "Looks like your purse is a bit light, dear. Come back when you've got the coin.",
            "choices": [
              {
                "label": "I'll be back.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rumor_1": {
            "id": "rumor_1",
            "text": "They say the tides pull strange things ashore at night... bones, old relics, things better left buried.",
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "moonhaven_rumor_1",
                "value": "true",
                "amount": 0
              }
            ],
            "choices": [
              {
                "label": "Interesting...",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ]
          },
          "rumor_2": {
            "id": "rumor_2",
            "text": "Old Mira down the lane's been treating more sick folk than usual. Something in the water, maybe. Or something under it.",
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "moonhaven_rumor_2",
                "value": "true",
                "amount": 0
              }
            ],
            "choices": [
              {
                "label": "Interesting...",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ]
          },
          "rumor_3": {
            "id": "rumor_3",
            "text": "A fisherman swore he saw lights beneath the southern reef. Glowing green, he said. Nobody believed him, but he hasn't gone back out since.",
            "actions": [
              {
                "type": "CLEAR_FLAG",
                "target": "moonhaven_rumor_1",
                "value": "",
                "amount": 0
