  "npcs": [
    {
      "id": "npc_gold_guard_korrath",
      "name": "War-Marshal Korrath",
      "spriteName": "npcs/townsman",
      "type": "QUESTGIVER",
      "defaultDialog": "Stand fast! The Golden War has no room for cowards.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 15,
      "y": 8,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Stand fast! I am Korrath, War-Marshal of the Gold Guard. Every blade in this camp answers to me — and if you're here, you'll answer too. Good steel beside you is worth more than gold.",
            "choices": [
              {
                "label": "I'm ready to fight.",
                "nextNodeId": "quest_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "eternal_siege_accepted",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Quest Active] I'm pushing the front.",
                "nextNodeId": "quest_progress",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "eternal_siege",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Siege Complete] The front is secure.",
                "nextNodeId": "siege_complete",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "eternal_siege",
                    "value": "",
                    "amount": 0
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "arena_offered",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "[Arena] I stood before Bellorak.",
                "nextNodeId": "arena_done",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "bellorak_arena",
                    "value": "",
                    "amount": 0
                  }
                ]
              },
              {
                "label": "Tell me about this war.",
                "nextNodeId": "war_lore",
                "conditions": []
              },
              {
                "label": "Farewell, Marshal.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "quest_offer": {
            "id": "quest_offer",
            "text": "Good. The eastern trenches, then.\nThere are War Wraiths in them. Ours, mostly — men who fell holding a line and have not been told the line is finished, because the line is never finished. Eight of them are thick enough to walk into.\nIt is not a rescue. There is nothing left in them to rescue. It is a courtesy.",
            "choices": [
              {
                "label": "I'll break their siege.",
                "nextNodeId": "quest_accept",
                "conditions": []
              },
              {
                "label": "Not yet.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "quest_accept": {
            "id": "quest_accept",
            "text": "That is the spirit, though I notice you did not say it like it was.\nEast through the war fields. Eight. And soldier — something about this war does not sit right with me. Thirty years, and neither side gains a yard, and every man I send east comes back either dead or exactly as useful as he was. Keep your eyes open and count things.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "eternal_siege",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "eternal_siege_accepted",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: The Eternal Siege",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "quest_progress": {
            "id": "quest_progress",
            "text": "Eight, soldier. They are not hard to find; they have not moved in thirty years, which is the entire problem with them and possibly with me.",
            "choices": [
              {
                "label": "On my way.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "siege_complete": {
            "id": "siege_complete",
            "text": "You did it. The eastern flank is ours. But... I've been thinking. Thirty years, neither side wins. The Reckoners rebuild as fast as we destroy. Something's feeding this war. There's an arena at the center of the island — Bellorak's arena. I hear the god himself watches the fights. Maybe the answer is there.",
            "choices": [
              {
                "label": "I'll investigate the arena.",
                "nextNodeId": "arena_accept",
                "conditions": []
              },
              {
                "label": "I need time to think.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "arena_accept": {
            "id": "arena_accept",
            "text": "Bellorak's Arena lies in the center of the island. Fight your way through, and demand an audience with the god. If this war is a game to him — we deserve to know.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "bellorak_arena",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "arena_offered",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: Bellorak's Arena",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "arena_done": {
            "id": "arena_done",
            "text": "You faced him. And you are standing here telling me about it. [He sets down his helm.] Thirty years I sent men east and called it duty. It was feed. Say it plain when you say it to the Reckoners — they have earned plain.",
            "choices": [
              {
                "label": "They will hear it from me.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "war_lore": {
            "id": "war_lore",
            "text": "The Golden War has raged for thirty years between the Gold Guard and the Iron Reckoners. We fight for Bellorak's favor — or so we're told. Honestly? I've lost my eye and half my friends, and I'm no closer to understanding why. Something about this war stinks, and it's not just the corpses.",
            "choices": [
              {
                "label": "You suspect the war is engineered?",
                "nextNodeId": "suspicion",
                "conditions": []
              },
              {
                "label": "I see.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "suspicion": {
            "id": "suspicion",
            "text": "Aye. Every time one side gains an advantage, something shifts. New weapons appear for the other side. Fresh recruits come from nowhere. It's like someone's keeping the scales balanced on purpose. And Bellorak's arena sits right in the middle, watching us bleed.",
            "choices": [
              {
                "label": "I'll look into it.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Stand fast, soldier. Good steel beside you.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_gold_guard_ives",
      "name": "Quartermaster Ives",
      "spriteName": "npcs/townsman",
      "type": "SHOPKEEPER",
      "defaultDialog": "Need gear? I've got the best iron on the island.",
      "questCompleteDialog": "",
      "shopItemIds": [
        "iron_warsword",
        "battle_plate",
        "champion_shield",
        "war_tonic",
        "travel_rations"
      ],
      "x": 22,
      "y": 15,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Quartermaster Ives, at your service. Every blade and breastplate in this camp passes through my hands. You look like you could use an upgrade — war's no place for dull steel.",
            "choices": [
              {
                "label": "Show me your wares.",
                "nextNodeId": "shop",
                "conditions": []
              },
              {
                "label": "How's the supply line?",
                "nextNodeId": "lore",
                "conditions": []
              },
              {
                "label": "You said it always evens out. Does it?",
                "nextNodeId": "glory_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "glory_costs_offered",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Active] Still breaking golems.",
                "nextNodeId": "glory_progress",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "what_glory_costs",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Complete] Five golems, and I counted.",
                "nextNodeId": "glory_done",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "what_glory_costs",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "glory_costs_done",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Never mind.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "shop": {
            "id": "shop",
            "text": "Finest war-grade equipment this side of the front. Everything's battle-tested — some of it more than once.",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_SHOP",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "lore": {
            "id": "lore",
            "text": "Supply line? Ha! There is no supply line. Everything we have, we forge or we take. The Reckoners have a forge-hand who can shape iron like butter — we've got numbers and discipline. It evens out. Always does.",
            "choices": [
              {
                "label": "Interesting.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Keep your blade sharp and your armor tight. War waits for no one.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "glory_offer": {
            "id": "glory_offer",
            "text": "[The cheerfulness goes off him like a coat.]\nNo. It does not even out. It over-evens.\nI issue a sword and I write it down. The man dies and I recover the sword and I write that down too. Thirty years of it, both columns, in my own hand. And every single year I have recovered more iron than I ever put out. Not a little more. Half again.\nWhere is it coming from? Nobody forges out there. The Reckoners have one forge-hand and she is good but she is one woman.\nThe golems. It has to be the golems — they are made of what we leave on the field, and when you break one it comes apart into gear, and there is more of it than went in. I have wanted somebody to test that for eleven years and I have never once had the nerve to ask a soldier to go and break five war-golems on my accountancy.\nI am asking now.",
            "choices": [
              {
                "label": "I'll break five and count what comes off.",
                "nextNodeId": "glory_accept",
                "conditions": []
              },
              {
                "label": "You have known this for eleven years.",
                "nextNodeId": "glory_accept",
                "conditions": []
              }
            ],
            "actions": []
          },
          "glory_accept": {
            "id": "glory_accept",
            "text": "Aye. Eleven years and a locked drawer. Judge me after you have done it.\nFive. Weigh what falls out of them, if you can. Guess, if you cannot.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "what_glory_costs",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "glory_costs_offered",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: What Glory Costs",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "glory_progress": {
            "id": "glory_progress",
            "text": "Five, and mind the count. A quartermaster with a bad number is worse than no quartermaster at all.",
            "choices": [
              {
                "label": "I am counting.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "glory_done": {
            "id": "glory_done",
            "text": "Half again. Every one of them. You are certain.\n[He sits down on a crate of somebody's returned breastplates.]\nThen it is not a war. A war consumes. This produces. Somebody is running a forge the size of an island and the fuel is us, and the product is more of the apparatus for using us, and it has been compounding for thirty years like a loan.\nI have spent my whole life being proud of never wasting a blade. Take four hundred and twenty and get out of my tent, and do not take it personally; I am going to be no use to anyone for about a week.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "glory_costs_done",
                "value": "true",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "PYRALIS",
                "value": "",
                "amount": 5
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Ives has proved the war manufactures its own materiel.",
                "value": "WARN",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_gold_guard_bram",
      "name": "Iron Keeper Bram",
      "spriteName": "npcs/townsman",
      "type": "INNKEEPER",
      "defaultDialog": "The barracks are open. Rest while you can — the war won't wait.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "x": 8,
      "y": 15,
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "I'm Bram, keeper of the barracks. You look like you've been through it. A hot meal and a cot will set you right — 20 gold for a full night's rest.",
            "choices": [
              {
                "label": "I'll rest. (Full heal, 20g)",
                "nextNodeId": "rest",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "value": "",
                    "amount": 20
                  }
                ]
              },
              {
                "label": "What's life like in camp?",
                "nextNodeId": "lore",
                "conditions": []
              },
              {
                "label": "Not now.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rest": {
            "id": "rest",
            "text": "Get some sleep. I'll keep the fire going. Tomorrow's another day of fighting, so rest well while the iron's quiet.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -20
              },
              {
                "type": "HEAL_PLAYER",
                "target": "",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "You rest in the Gold Guard barracks. The sounds of the camp fade as you sleep.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "lore": {
            "id": "lore",
            "text": "Camp life is simple. Train. Fight. Rest. Repeat. The Marshal keeps us sharp, and the Quartermaster keeps us armed. We've been at this so long most of us don't remember anything else. That's the war for you — it becomes your whole world.",
            "choices": [
              {
                "label": "Sounds exhausting.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell": {
            "id": "farewell",
            "text": "Stay sharp out there. The barracks are always open when you need them.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": "npc_gold_guard_ionna",
      "name": "Letter-Keeper Ionna",
      "spriteName": "npcs/townswoman",
      "type": "QUESTGIVER",
      "defaultDialog": "Every man in this camp has written one. Most of them twice.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Every man in this camp has written one. Most of them twice — they write it, they survive a season, they decide the first one was sentimental and write a better one.\n[The chest behind her is the size of a coffin and it is full to the lid.]\nI am Ionna. I keep the letters. If you fall, I deliver yours. If I fall, the next one keeps them. That is the whole post and it has never once been vacant.",
            "choices": [
              {
                "label": "How many are still undelivered?",
                "nextNodeId": "ionna_count",
                "conditions": []
              },
              {
                "label": "There's one on the top you keep looking at.",
                "nextNodeId": "letter_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "letter_offered",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Active] I have not been down to the Pit yet.",
                "nextNodeId": "letter_progress",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "the_thirty_year_letter",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Quest Complete] I took it down there.",
                "nextNodeId": "letter_done",
                "conditions": [
                  {
                    "type": "QUEST_COMPLETE",
                    "target": "the_thirty_year_letter",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "letter_delivered",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Keep well, Letter-Keeper.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "ionna_count": {
            "id": "ionna_count",
            "text": "Four thousand and six.\nNot because I am slow. Because the people they are addressed to are in this camp, and this camp goes east, and a letter to a dead man goes back in the chest.\nThere are letters in there that have been re-addressed four times. A father to a son, the son to his wife, the wife to her sister. All in the box. All in my handwriting by the end, because the paper gives out before the family does.",
            "choices": [
              {
                "label": "There's one on the top you keep looking at.",
                "nextNodeId": "letter_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "letter_offered",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "That is a hard post.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "letter_offer": {
            "id": "letter_offer",
            "text": "You have a good eye and I wish you had not.\nCaptain Corran, Gold Guard, fell at the Pit thirty-one years ago. Sealed. Addressed to a woman who was in neither army and had no camp and no post and no rank: Seraphine.\nHe met her once. Wrote about it for a year. She told him the war was a farm and that he ought to walk out of it, and he did not, and then he wrote this, and then he went east.\nI cannot deliver it. I have carried it thirty-one years and every keeper before me carried it and not one of us has known where to put it.\n[She holds it out.] You are going down to the Pit. Take it with you. I am not going to tell you what to do with it down there — I have thought about it for eleven years and I still do not know.",
            "choices": [
              {
                "label": "[Take the letter.]",
                "nextNodeId": "letter_accept",
                "conditions": []
              },
              {
                "label": "It is not mine to carry.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "letter_accept": {
            "id": "letter_accept",
            "text": "Then it is carried. That is already more than it has had.\n[She writes something in a book — one line, first line she has written on that page in thirty-one years.]\nGo on. And Traveller: it is not addressed to a memory. Keepers are very strict about that. It is addressed to a person, present tense, because Corran wrote it that way and I am not permitted to correct him.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "the_thirty_year_letter",
                "value": "",
                "amount": 0
              },
              {
                "type": "GIVE_ITEM",
                "target": "thirty_year_letter",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "letter_offered",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Quest accepted: The Thirty-Year Letter. You carry Corran's Letter.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "letter_progress": {
            "id": "letter_progress",
            "text": "The Pit is south-east of here, past the crater line. Do not open it on the way. I have not, and I have had thirty-one years and a knife.",
            "choices": [
              {
                "label": "I will not.",
                "nextNodeId": "farewell",
                "conditions": []
              }
            ],
            "actions": []
          },
          "letter_done": {
            "id": "letter_done",
            "text": "You took it down. [She does not ask whether it was received; she has been doing this too long to ask that.]\nThen it is delivered. In the register that is what delivered means: it went to the place the person is. Nothing about it says the person has to take it.\n[She strikes the line out and writes DELIVERED beside it and her hand is not steady.]\nThirty-one years. Four keepers. That is the oldest live entry in the book and it has just gone dead, and I did not expect to mind.",
            "choices": [
              {
                "label": "She is alive down there. She is on the card.",
                "nextNodeId": "letter_seraphine",
                "conditions": [
                  {
                    "type": "FLAG_SET",
                    "target": "seraphine_file_read",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "[Say nothing about what is down there.]",
                "nextNodeId": "letter_close",
                "conditions": []
              }
            ],
            "actions": []
          },
          "letter_seraphine": {
            "id": "letter_seraphine",
            "text": "[She sits down on the letter chest.]\nOn the card. Twenty-two years on the card.\nThen Corran was writing to somebody who could still have read it, this whole time, and every keeper who told herself it was a letter to a ghost was telling herself a comfortable thing.\n...He asked her to walk out. In the letter. He asks her to walk out of it, in the last paragraph, and he never once asked himself.\nWhen you go back down — and you are going back down, I can see it on you the way I can see it on all of them — do not ask her to walk out. Everyone has asked her to walk out. Corran asked her to walk out and then stayed himself, which is exactly what the god wants from all of us.\nAsk her what she would need in order to stop. That is a different question. Nobody has asked her that one in twenty-two years because nobody has been willing to hear the answer.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "letter_delivered",
                "value": "true",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "UMBRYN",
                "value": "",
                "amount": 10
              },
              {
                "type": "ADD_FAVOR",
                "target": "BELLORAK",
                "value": "",
                "amount": 5
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Ionna: do not ask her to walk out. Ask what she would need in order to stop.",
                "value": "GOOD",
                "amount": 0
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "letter_close": {
            "id": "letter_close",
            "text": "[She closes the chest and sits on it.] Go on. I would like a minute with a job that is finished, and I get one about every eleven years.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "letter_delivered",
                "value": "true",
                "amount": 0
              },
              {
                "type": "ADD_FAVOR",
                "target": "UMBRYN",
                "value": "",
                "amount": 5
              },
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "farewell": {
            "id": "farewell",
            "text": "If you write one, bring it to me and not to a friend. Friends lose them. It is not their fault; they are usually east.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 22,
      "y": 22
    }
  ],
  "townEntrances": [],
  "overworldTeleporters": []
}