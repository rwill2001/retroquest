    {
      "id": "npc_mooncrest_veiled",
      "name": "The Veiled One",
      "spriteName": "npcs/oracle",
      "type": "TOWNSFOLK",
      "defaultDialog": "Mooncrest only wakes at night. Some of us never sleep.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "The shadows between the stars whisper your name, traveler. I have listened... and they have much to say.",
            "choices": [
              {
                "label": "Who are you?",
                "nextNodeId": "who_are_you",
                "conditions": []
              },
              {
                "label": "Can you teach me anything?",
                "nextNodeId": "teach_menu",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "who_are_you": {
            "id": "who_are_you",
            "text": "Names are chains, and I shed mine long ago. I see what others cannot — the threads that bind fate to flesh. Mooncrest tolerates me because even the fearful need answers.",
            "choices": [
              {
                "label": "What do you know about Mooncrest?",
                "nextNodeId": "about_mooncrest",
                "conditions": []
              },
              {
                "label": "Can you teach me anything?",
                "nextNodeId": "teach_menu",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "about_mooncrest": {
            "id": "about_mooncrest",
            "text": "This town sits where two ley lines cross. The veil is thin here — thinner than most realize. That is why the temple was built, and why I stay. Power pools in places like this, waiting to be shaped.",
            "choices": [
              {
                "label": "Can you teach me anything?",
                "nextNodeId": "teach_menu",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "teach_menu": {
            "id": "teach_menu",
            "text": "Knowledge is never free. But for gold, I can open your mind to sacred arts. What would you learn?",
            "choices": [
              {
                "label": "Protection from Evil (10 gold)",
                "nextNodeId": "teach_prot_check",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 10,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Turn Undead (25 gold)",
                "nextNodeId": "teach_turn_check",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 25,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Prayer (50 gold)",
                "nextNodeId": "teach_prayer_check",
                "conditions": [
                  {
                    "type": "PLAYER_LEVEL",
                    "target": "",
                    "amount": 3,
                    "negate": false
                  },
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 50,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Holy Word (75 gold)",
                "nextNodeId": "teach_holyword_check",
                "conditions": [
                  {
                    "type": "PLAYER_LEVEL",
                    "target": "",
                    "amount": 5,
                    "negate": false
                  },
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 75,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Never mind."
              }
            ],
            "actions": []
          },
          "teach_prot_check": {
            "id": "teach_prot_check",
            "text": "A ward against darkness. Simple, yet vital.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -10
              },
              {
                "type": "TEACH_SPELL",
                "target": "Protection from Evil",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The Veiled One traces a sigil in the air. The knowledge burns itself into your mind.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "teach_turn_check": {
            "id": "teach_turn_check",
            "text": "The dead do not rest easily in these lands. You will need this.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -25
              },
              {
                "type": "TEACH_SPELL",
                "target": "Turn Undead",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Holy light flickers between her fingers as the prayer takes root in your soul.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "teach_prayer_check": {
            "id": "teach_prayer_check",
            "text": "Prayer requires conviction. The gods answer only those who truly believe.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -50
              },
              {
                "type": "TEACH_SPELL",
                "target": "Prayer",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The Veiled One murmurs ancient words. You feel a divine presence settle into your being.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "teach_holyword_check": {
            "id": "teach_holyword_check",
            "text": "The Holy Word is not spoken lightly. It carries the weight of judgment itself.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
