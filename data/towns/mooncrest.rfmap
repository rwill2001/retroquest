  "interiorEntryX": 1,
  "interiorEntryY": 31,
  "npcs": [
    {
      "id": "npc_mooncrest_innkeeper",
      "name": "Oswin",
      "spriteName": "npcs/innkeeper",
      "type": "INNKEEPER",
      "defaultDialog": "Rest your bones, traveler. The Crescent Cup welcomes all — day or night.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Welcome to the Crescent Cup. Best ale in Mooncrest — and the only ale, truth be told.",
            "choices": [
              {
                "label": "I'd like a room for the night.",
                "nextNodeId": "rest_offer",
                "conditions": []
              },
              {
                "label": "What can you tell me about Mooncrest?",
                "nextNodeId": "about_town",
                "conditions": []
              },
              {
                "label": "Who else lives here?",
                "nextNodeId": "about_people",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "rest_offer": {
            "id": "rest_offer",
            "text": "5 gold for a warm bed and a quiet room. The moon keeps odd hours here, but you'll sleep sound.",
            "choices": [
              {
                "label": "I'll take it.",
                "nextNodeId": "rest_confirm",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 5,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Too rich for my blood.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rest_confirm": {
            "id": "rest_confirm",
            "text": "Rest well, traveler.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -5
              },
              {
                "type": "HEAL_PLAYER",
                "target": "",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "You rest at the Crescent Cup and feel fully restored.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "about_town": {
            "id": "about_town",
            "text": "Mooncrest's been here longer than anyone remembers. The temple's the heart of it — dedicated to Lirandel. We get pilgrims sometimes, seekers and scholars. And the odd adventurer, of course.",
            "choices": [
              {
                "label": "I'd like a room.",
                "nextNodeId": "rest_offer",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "about_people": {
            "id": "about_people",
            "text": "Lyren keeps to himself — brilliant but prickly. Sister Caela runs the temple's healing wing. The Veiled One... well, she's been here since before I was born. And there's Rook. Don't ask me what he does. I don't want to know.",
            "choices": [
              {
                "label": "Thanks for the information.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          }
        }
      },
      "x": 17,
      "y": 16
    },
    {
      "id": "npc_mooncrest_lyren",
      "name": "Lyren the Pale",
      "spriteName": "npcs/oracle",
      "type": "TOWNSFOLK",
      "defaultDialog": "Knowledge has a price. The moon reveals what the sun hides.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "A pale figure sits hunched over a desk covered in star charts and cracked lenses. He doesn't look up. 'The door was locked for a reason. I assume you had a key, or you're more resourceful than you look.'",
            "choices": [
              {
                "label": "Aldric sent me to find you.",
                "nextNodeId": "hermit_found",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "find_the_hermit",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Aldric needs a Mooncrest Stone from you.",
                "nextNodeId": "stone_request",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "alchemists_stone",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "lyren_stone_given",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I wanted to ask you something.",
                "nextNodeId": "ask_menu",
                "conditions": [
                  {
                    "type": "FLAG_SET",
                    "target": "lyren_met",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Just exploring. Who are you?",
                "nextNodeId": "who_are_you",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "lyren_met",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Good to see you again, Lyren.",
                "nextNodeId": "return_visit",
                "conditions": [
                  {
                    "type": "FLAG_SET",
                    "target": "lyren_stone_given",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Sorry to bother you.",
                "nextNodeId": "farewell_cold",
                "conditions": []
              }
            ],
            "actions": []
          },
          "hermit_found": {
            "id": "hermit_found",
            "text": "He finally looks up. His eyes are pale grey, almost white. 'Aldric. That old fool is still mixing potions in that cellar of his? I haven't spoken to him in... years, I think. Time moves strangely when you study the ley lines.' He sighs. 'What does he want now?'",
            "choices": [
              {
                "label": "He said he needs your help with something. He'll explain when I return.",
                "nextNodeId": "hermit_accept",
                "conditions": []
              },
              {
                "label": "Why do you live behind a locked door?",
                "nextNodeId": "why_locked",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "lyren_met",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "why_locked": {
            "id": "why_locked",
            "text": "'Because people ask questions.' He gestures at the star charts on his walls. 'I study the convergence of the ley lines beneath Mooncrest. Two of them cross directly under this temple. The energy here is... extraordinary. And dangerous. I don't need visitors stumbling into my work and getting themselves killed.'",
            "choices": [
              {
                "label": "Ley lines? What are those?",
                "nextNodeId": "ley_lines",
                "conditions": []
              },
              {
                "label": "Aldric will be glad to know you're alive.",
                "nextNodeId": "hermit_accept",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "find_the_hermit",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Fair enough. I'll leave you to it.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "ley_lines": {
            "id": "ley_lines",
            "text": "'Channels of raw magical energy that run beneath the earth. Most people can't sense them, but every mage worth their salt knows they exist. Mooncrest was built on a nexus — two lines crossing. That's why the temple was raised here, why the moon seems brighter over this town.' He taps a chart. 'And why I stay.'",
            "choices": [
              {
                "label": "That's fascinating. I should tell Aldric you're well.",
                "nextNodeId": "hermit_accept",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "find_the_hermit",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Is the energy dangerous to visitors?",
                "nextNodeId": "energy_danger",
                "conditions": []
              },
              {
                "label": "Thanks for explaining. I'll let you work.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "energy_danger": {
            "id": "energy_danger",
            "text": "'Not to someone passing through. But if you were to, say, try to channel it without understanding what you're doing...' He trails off, and you notice scorch marks on the ceiling. 'Let's just say I learned the hard way. Twice.'",
            "choices": [
              {
                "label": "I'll be careful. Thanks, Lyren.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "hermit_accept": {
            "id": "hermit_accept",
            "text": "'Alive is generous. Functional, perhaps.' A ghost of a smile crosses his face. 'Tell Aldric I'm here if he needs me. But he'll have to send you back — I'm not leaving this study. Not while the alignment is so close.'",
            "choices": [
              {
                "label": "I'll pass the message along.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "LOG_MESSAGE",
                "target": "Lyren acknowledges Aldric's request. Return to Aldric.",
                "value": "",
                "amount": 0
              }
            ]
          },
          "stone_request": {
            "id": "stone_request",
            "text": "Lyren pinches the bridge of his nose. 'A Mooncrest Stone. Of course. Those are attuned to the ley line nexus — extremely difficult to find, and even harder to keep stable. I happen to have one, but I've been using it to calibrate my instruments.'",
            "choices": [
              {
                "label": "He said it's important for his research.",
                "nextNodeId": "stone_consider",
                "conditions": []
              },
              {
                "label": "He said you owe him a favor.",
                "nextNodeId": "stone_favor",
                "conditions": []
              }
            ],
            "actions": []
          },
          "stone_consider": {
            "id": "stone_consider",
            "text": "'Everything is important to Aldric. The man treats every potion like it could save the world.' He pauses, staring at a faintly glowing stone on his desk. 'But... I suppose I've gathered all the readings I need. The next lunar convergence isn't for three years anyway.'",
            "choices": [
              {
                "label": "So you'll part with it?",
                "nextNodeId": "stone_give",
                "conditions": []
              }
            ],
            "actions": []
          },
          "stone_favor": {
            "id": "stone_favor",
            "text": "Lyren barks a short laugh. 'A favor? That man pulled me out of a collapsing ruin in the Dustlands twenty years ago. I've owed him more than a stone since then.' He reaches for the desk. 'Fine. He wins. As usual.'",
            "choices": [
              {
                "label": "Thank you, Lyren.",
                "nextNodeId": "stone_give",
                "conditions": []
              }
            ],
            "actions": []
          },
          "stone_give": {
            "id": "stone_give",
            "text": "He carefully wraps the stone in a cloth and hands it to you. It pulses faintly with a cool, blue-white light. 'Handle it gently — it resonates with the ley lines and can be... unpredictable. Tell Aldric he owes me a bottle of his best elixir. And tell him to visit sometime. I may be a recluse, but I'm not dead yet.'",
            "choices": [
              {
                "label": "I'll make sure he gets both messages.",
                "nextNodeId": "stone_aftermath",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_ITEM",
                "target": "mooncrest_stone",
                "value": "",
                "amount": 1
              },
              {
                "type": "SET_FLAG",
                "target": "lyren_stone_given",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "stone_aftermath": {
            "id": "stone_aftermath",
            "text": "'One more thing.' Lyren's expression turns serious. 'The ley lines have been... restless lately. I've felt tremors in the readings — something stirring deep below. Be careful out there. Whatever Aldric is working on, I hope it's worth it.'",
            "choices": [
              {
                "label": "I'll keep my eyes open. Thank you.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              },
              {
                "label": "Restless? What do you think it means?",
                "nextNodeId": "ley_warning",
                "conditions": []
              }
            ],
            "actions": []
          },
          "ley_warning": {
            "id": "ley_warning",
            "text": "'I don't know yet. Could be natural — the lines shift over centuries. But the pattern doesn't match anything in my records.' He glances at his charts. 'It almost looks like something is pulling on them. From below. I need more data before I can say anything certain. Just... watch for signs. Strange magic. Places where the air feels wrong.'",
            "choices": [
              {
                "label": "I'll let you know if I see anything unusual.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "lyren_ley_warning",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "who_are_you": {
            "id": "who_are_you",
            "text": "'Lyren. Some call me Lyren the Pale, on account of...' He gestures vaguely at himself. His skin is almost translucent, as though he hasn't seen sunlight in years. 'I'm a scholar. I study the ley lines that converge beneath this temple. It's solitary work, which suits me fine.'",
            "choices": [
              {
                "label": "What are ley lines?",
                "nextNodeId": "ley_lines",
                "conditions": []
              },
              {
                "label": "Why do you lock yourself away?",
                "nextNodeId": "why_locked",
                "conditions": []
              },
              {
                "label": "Interesting. I'll leave you to your work.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "lyren_met",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "ask_menu": {
            "id": "ask_menu",
            "text": "Lyren looks up from his charts. 'You again. Make it quick — the readings are particularly active tonight.'",
            "choices": [
              {
                "label": "What can you tell me about Mooncrest?",
                "nextNodeId": "about_mooncrest",
                "conditions": []
              },
              {
                "label": "How is your research going?",
                "nextNodeId": "research_update",
                "conditions": []
              },
              {
                "label": "Have you noticed anything strange lately?",
                "nextNodeId": "strange_things",
                "conditions": [
                  {
                    "type": "FLAG_SET",
                    "target": "lyren_stone_given",
                    "value": "",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Never mind. I'll let you work.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "about_mooncrest": {
            "id": "about_mooncrest",
            "text": "'Mooncrest is old. Older than anyone knows. The temple was built on a ley line nexus — two currents of raw magical energy crossing beneath our feet. That's why the moon hangs so bright over this town, why the air feels charged at night. Pilgrims think it's divine. I think it's geology.'",
            "choices": [
              {
                "label": "You don't believe in the gods?",
                "nextNodeId": "gods_belief",
                "conditions": []
              },
              {
                "label": "Thanks. That's helpful.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "gods_belief": {
            "id": "gods_belief",
            "text": "'I believe in what I can measure. The ley lines are real — I've mapped them, tested them, been burned by them. Whether a god put them there or they've simply always existed...' He shrugs. 'That's a question for Sister Caela, not me.'",
            "choices": [
              {
                "label": "A fair answer. Thanks, Lyren.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "research_update": {
            "id": "research_update",
            "text": "'Slowly. The ley lines don't follow predictable patterns — they shift with the lunar cycle, with seismic activity, sometimes with no apparent cause at all. I've been recording readings for six years and I still can't predict them reliably.' He almost sounds excited about it.",
            "choices": [
              {
                "label": "Sounds like a lifetime's work.",
                "nextNodeId": "lifetime_work",
                "conditions": []
              },
              {
                "label": "Good luck with it.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "lifetime_work": {
            "id": "lifetime_work",
            "text": "'At least. But if I can map the full convergence pattern, we could predict surges — channel that energy safely. Imagine: healing springs that never run dry, barriers that hold without a mage sustaining them. The applications would be...' He catches himself and clears his throat. 'Theoretical, of course. For now.'",
            "choices": [
              {
                "label": "That sounds incredible. Keep at it.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "strange_things": {
            "id": "strange_things",
            "text": "'Define strange.' He pauses. 'Actually, yes. The readings have been erratic — sharp spikes, then dead silence. As if something is tapping the ley lines and then releasing them. I've never seen a pattern like it. If I didn't know better, I'd say something underground is... feeding.'",
            "choices": [
              {
                "label": "That sounds ominous.",
                "nextNodeId": "ominous",
                "conditions": []
              },
              {
                "label": "I'll keep watch for anything unusual.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "ominous": {
            "id": "ominous",
            "text": "'Ominous is my default state.' The ghost of a smile. 'But yes. Be wary in the deeper places — dungeons, caves, anywhere close to the earth's bones. If the ley lines are being disturbed, the effects could be unpredictable. Stronger monsters, stranger magic, places that shift when they shouldn't.'",
            "choices": [
              {
                "label": "I appreciate the warning. Stay safe, Lyren.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "lyren_ley_warning",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "return_visit": {
            "id": "return_visit",
            "text": "'Ah, the courier returns.' Lyren's tone is dry, but there's a warmth in it that wasn't there before. 'Did Aldric get his precious stone? I trust he didn't blow himself up with it.'",
            "choices": [
              {
                "label": "He sends his thanks.",
                "nextNodeId": "aldric_thanks",
                "conditions": []
              },
              {
                "label": "I wanted to ask you something.",
                "nextNodeId": "ask_menu",
                "conditions": []
              },
              {
                "label": "Just checking in. Take care.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "aldric_thanks": {
            "id": "aldric_thanks",
            "text": "'Thanks from Aldric usually come in liquid form. If he sends a bottle of that golden elixir of his, I might even open my door for the delivery.' He turns back to his charts, but you can tell he's pleased.",
            "choices": [
              {
                "label": "I'll see what I can do. Farewell.",
                "nextNodeId": "farewell_warm",
                "conditions": []
              }
            ],
            "actions": []
          },
          "farewell_cold": {
            "id": "farewell_cold",
            "text": "Lyren has already turned back to his charts. He waves a hand dismissively without looking up.",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "farewell_warm": {
            "id": "farewell_warm",
            "text": "'Safe travels. And... close the door behind you. I have a draft problem as it is.'",
            "choices": [],
            "actions": [
              {
                "type": "CLOSE_DIALOGUE",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 24,
      "y": 15
    },
    {
      "id": "npc_mooncrest_dagan",
      "name": "Dagan",
      "spriteName": "npcs/shopkeeper",
      "type": "SHOPKEEPER",
      "defaultDialog": "Finest steel in the region. Name your need.",
      "questCompleteDialog": "",
      "shopItemIds": [
        "steel_sword",
        "plate_mail",
        "ring_protection",
        "healing_potion",
        "greater_healing",
        "antidote",
        "hard_bread",
        "dried_fish",
        "travel_rations"
      ],
      "dialogueTree": {
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "id": "greeting",
            "text": "Steel, mail, and remedies. What's your pleasure?",
            "choices": [
              {
                "label": "Show me your wares.",
                "nextNodeId": "open_shop",
                "conditions": []
              },
              {
                "label": "Where do you get your steel?",
                "nextNodeId": "about_goods",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "open_shop": {
            "id": "open_shop",
            "text": "Have a look.",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_SHOP",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "about_goods": {
            "id": "about_goods",
            "text": "I forge what I can and trade for the rest. Ships come through the harbor when the tides allow it. The plate mail? That's my pride — forged it myself on the night of a full moon. Lirandel smiled on the steel, I think.",
            "choices": [
              {
                "label": "Let me see your stock.",
                "nextNodeId": "open_shop",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          }
        }
      },
      "x": 42,
      "y": 15
    },
    {
      "id": "npc_mooncrest_rook",
      "name": "Rook",
      "spriteName": "npcs/thief",
      "type": "SHOPKEEPER",
      "defaultDialog": "Fast horses, no questions asked. That's my trade.",
      "questCompleteDialog": "",
      "shopItemIds": [
        "antidote",
        "rusty_key",
        "iron_key",
        "travel_rations"
      ],
      "dialogueTree": {
        "startNodeId": "start_router",
        "nodes": {
          "start_router": {
            "id": "start_router",
            "text": "...",
            "choices": [
              {
                "label": "(Approach)",
                "nextNodeId": "trusted_greeting",
                "conditions": [
                  {
                    "type": "FLAG_SET",
                    "target": "rook_trusted",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "(Approach)",
                "nextNodeId": "suspicious_greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "suspicious_greeting": {
            "id": "suspicious_greeting",
            "text": "You're not from around here. I don't do business with strangers.",
            "choices": [
              {
                "label": "Frederick sent me.",
                "nextNodeId": "vouch_path",
                "conditions": [
                  {
                    "type": "FLAG_SET",
                    "target": "frederick_vouch",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I have gold. Lots of it.",
                "nextNodeId": "bribe_path",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 25,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Never mind."
              }
            ],
            "actions": []
          },
          "vouch_path": {
            "id": "vouch_path",
            "text": "Frederick vouched for you? That man's word is iron. Alright, you're in.",
            "choices": [
              {
                "label": "What do you have?",
                "nextNodeId": "trusted_greeting",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "rook_trusted",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "bribe_path": {
            "id": "bribe_path",
            "text": "Gold talks. Fine. But if you bring guards to my door, you'll regret it.",
            "choices": [
              {
                "label": "Deal.",
                "nextNodeId": "trusted_greeting",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -25
              },
              {
                "type": "SET_FLAG",
                "target": "rook_trusted",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "trusted_greeting": {
            "id": "trusted_greeting",
            "text": "What do you need? I've got goods, and I've got information.",
            "choices": [
              {
                "label": "Show me what you've got.",
                "nextNodeId": "open_shop",
                "conditions": []
              },
              {
                "label": "Any rumors worth hearing?",
                "nextNodeId": "rumors_menu",
                "conditions": []
              },
              {
                "label": "I have your Veil Shard.",
                "nextNodeId": "shard_turnin",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "shadow_errand",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "HAS_ITEM",
                    "target": "veil_shard",
                    "amount": 1,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Nothing right now."
              }
            ],
            "actions": []
          },
          "open_shop": {
            "id": "open_shop",
            "text": "Keep your voice down.",
            "choices": [],
            "actions": [
              {
                "type": "OPEN_SHOP",
                "target": "",
                "value": "",
                "amount": 0
              }
            ]
          },
          "rumors_menu": {
            "id": "rumors_menu",
            "text": "Information costs 10 gold per tip. Fair?",
            "choices": [
              {
                "label": "Tell me about the temple.",
                "nextNodeId": "rumor_temple",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 10,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "rook_rumor_temple",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "What's beneath Mooncrest?",
                "nextNodeId": "rumor_beneath",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 10,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "rook_rumor_beneath",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Got any dangerous work?",
                "nextNodeId": "shadow_errand_offer",
                "conditions": [
                  {
                    "type": "PLAYER_LEVEL",
                    "target": "",
                    "amount": 3,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "rook_quest_given",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "That's all.",
                "nextNodeId": "trusted_greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "rumor_temple": {
            "id": "rumor_temple",
            "text": "The temple wasn't always a temple. It was built over something older — a lunar focus, they call it. The Veiled One knows more, but she won't tell you unless you've proven yourself.",
            "choices": [
              {
                "label": "Interesting.",
                "nextNodeId": "rumors_menu",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -10
              },
              {
                "type": "SET_FLAG",
                "target": "rook_rumor_temple",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "You paid Rook 10 gold for information.",
                "value": "INFO",
                "amount": 0
              }
            ]
          },
          "rumor_beneath": {
            "id": "rumor_beneath",
            "text": "There are tunnels beneath this town — old ones, from before Mooncrest had a name. I've been in the first stretch. Something down there glows, and it isn't torches.",
            "choices": [
              {
                "label": "Good to know.",
                "nextNodeId": "rumors_menu",
                "conditions": []
              }
            ],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -10
              },
              {
                "type": "SET_FLAG",
                "target": "rook_rumor_beneath",
                "value": "true",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "You paid Rook 10 gold for information.",
                "value": "INFO",
                "amount": 0
              }
            ]
          },
          "shadow_errand_offer": {
            "id": "shadow_errand_offer",
            "text": "There is a job, if you have the nerve for a quiet one.\nThere is a blind scholar in the eastern ruins — Verath. Lost his eyes in the Dreamwake thirty years back and came up holding a Veil Shard, which is a splinter off the barrier the gods look through. He has never sold it and he has never explained it.\nHe will not give it to me. He has met me. He might give it to you, which is a thing I have noticed about you and have not decided how I feel about.\nBring it back and I will make it worth the walk.",
            "choices": [
              {
                "label": "I'll get it.",
                "nextNodeId": "errand_accepted",
                "conditions": []
              },
              {
                "label": "Not interested.",
                "nextNodeId": "trusted_greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "errand_accepted": {
            "id": "errand_accepted",
            "text": "Good. East, past the moor, up in the ruins. And do not ask him what the veil is for — he will tell you, and then you will be a person who knows, and knowing is the expensive part.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "shadow_errand",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "rook_quest_given",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "shard_turnin": {
            "id": "shard_turnin",
            "text": "You actually got it. I'm impressed. This shard... it hums. Can you feel it? There's a whole other world pressing against ours, and this little fragment holds it back. Here's your pay. You've earned it.",
            "choices": [],
            "actions": [
              {
                "type": "TAKE_ITEM",
                "target": "veil_shard",
                "value": "",
                "amount": 1
              },
              {
                "type": "COMPLETE_QUEST",
                "target": "shadow_errand",
                "value": "",
                "amount": 0
              },
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": 30
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Rook tucks the shard into his coat. It pulses faintly through the fabric.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 50,
      "y": 19
    },
    {
      "id": "npc_mooncrest_caela",
      "name": "Sister Caela",
      "spriteName": "npcs/priest",
      "type": "HEALER",
      "defaultDialog": "The body heals when the spirit is willing. Let me help.",
      "questCompleteDialog": "",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start_router",
        "nodes": {
          "start_router": {
            "id": "start_router",
            "text": "...",
            "choices": [
              {
                "label": "(Approach)",
                "nextNodeId": "quest_turnin",
                "conditions": [
                  {
                    "type": "QUEST_ACTIVE",
                    "target": "temple_purification",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "temple_purification_complete",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "(Approach)",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "greeting": {
            "id": "greeting",
            "text": "Lirandel's light be upon you, child. How may I help?",
            "choices": [
              {
                "label": "I need healing.",
                "nextNodeId": "heal_offer",
                "conditions": []
              },
              {
                "label": "Tell me about Lirandel.",
                "nextNodeId": "about_lirandel",
                "conditions": []
              },
              {
                "label": "Tell me about the temple.",
                "nextNodeId": "about_temple",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "heal_offer": {
            "id": "heal_offer",
            "text": "Lirandel's grace flows through these hands. A small offering of gold is all I ask.",
            "choices": [
              {
                "label": "Please heal me. (8 gold)",
                "nextNodeId": "heal_confirm",
                "conditions": [
                  {
                    "type": "HAS_GOLD",
                    "target": "",
                    "amount": 8,
                    "negate": false
                  }
                ]
              },
              {
                "label": "Not right now.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "heal_confirm": {
            "id": "heal_confirm",
            "text": "Be whole.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": -8
              },
              {
                "type": "HEAL_PLAYER",
                "target": "",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Sister Caela's hands glow with silver light. Your wounds close and your strength returns.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "about_lirandel": {
            "id": "about_lirandel",
            "text": "Lirandel is the Moon Goddess — she rules dreams, silver light, and the tides of fate. This temple was built where two ley lines cross, a place where her power is strongest. Those who serve her faithfully find their dreams are... clearer.",
            "choices": [
              {
                "label": "May I pray at the altar?",
                "nextNodeId": "pray_option",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "prayed_lirandel",
                    "amount": 0,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I need healing.",
                "nextNodeId": "heal_offer",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "pray_option": {
            "id": "pray_option",
            "text": "Of course. Approach the altar with an open heart. Lirandel hears all prayers spoken in this place.",
            "choices": [],
            "actions": [
              {
                "type": "SET_FLAG",
                "target": "prayed_lirandel",
                "value": "true",
                "amount": 0
              },
              {
                "type": "HEAL_PLAYER",
                "target": "",
                "value": "",
                "amount": 15
              },
              {
                "type": "LOG_MESSAGE",
                "target": "You kneel before the Altar of Lirandel. A cool silver light washes over you. +15 HP.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          },
          "about_temple": {
            "id": "about_temple",
            "text": "The Temple of Lirandel has stood here for centuries. Pilgrims come from across the islands to pray. The Veiled One arrived decades ago and took up residence in the lower chambers. She is... tolerated. Her knowledge serves the faithful, even if her methods are unorthodox.",
            "choices": [
              {
                "label": "I've sensed something dark here.",
                "nextNodeId": "quest_offer",
                "conditions": [
                  {
                    "type": "FLAG_NOT_SET",
                    "target": "caela_quest_given",
                    "amount": 0,
                    "negate": false
                  },
                  {
                    "type": "PLAYER_LEVEL",
                    "target": "",
                    "amount": 2,
                    "negate": false
                  }
                ]
              },
              {
                "label": "I need healing.",
                "nextNodeId": "heal_offer",
                "conditions": []
              },
              {
                "label": "Farewell."
              }
            ],
            "actions": []
          },
          "quest_offer": {
            "id": "quest_offer",
            "text": "You sense it too? Dark energy has been seeping into the temple from below. The dead stir in the old tunnels — skeletons, drawn by the ley lines. If you could slay them, the temple would breathe easier. Lirandel would smile upon such an act.",
            "choices": [
              {
                "label": "I'll do it.",
                "nextNodeId": "quest_accepted",
                "conditions": []
              },
              {
                "label": "Not right now.",
                "nextNodeId": "greeting",
                "conditions": []
              }
            ],
            "actions": []
          },
          "quest_accepted": {
            "id": "quest_accepted",
            "text": "Thank you. May Lirandel guide your blade.",
            "choices": [],
            "actions": [
              {
                "type": "GIVE_QUEST",
                "target": "temple_purification",
                "value": "",
                "amount": 0
              },
              {
                "type": "SET_FLAG",
                "target": "caela_quest_given",
                "value": "true",
                "amount": 0
              }
            ]
          },
          "quest_turnin": {
            "id": "quest_turnin",
            "text": "The temple breathes easier. I can feel it. You have Lirandel's gratitude — and mine.",
            "choices": [],
            "actions": [
              {
                "type": "COMPLETE_QUEST",
                "target": "temple_purification",
                "value": "",
                "amount": 0
              },
              {
                "type": "GIVE_GOLD",
                "target": "",
                "value": "",
                "amount": 12
              },
              {
                "type": "LOG_MESSAGE",
                "target": "Sister Caela bows her head in thanks. The air around the temple feels lighter.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          }
        }
      },
      "x": 16,
      "y": 43
