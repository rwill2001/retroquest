    {
      "id": "npc_frederick_mooncrest",
      "name": "Frederick",
      "spriteName": "npcs/townsman",
      "type": "TOWNSFOLK",
      "defaultDialog": "Welcome to Mooncrest. It's quiet here, but I like it that way.",
      "shopItemIds": [],
      "dialogueTree": {
        "startNodeId": "start_router",
        "nodes": {
          "start_router": {
            "id": "start_router",
            "text": "...",
