              },
              {
                "type": "TEACH_SPELL",
                "target": "Holy Word",
                "value": "",
                "amount": 0
              },
              {
                "type": "LOG_MESSAGE",
                "target": "The air trembles as forbidden syllables pass from her lips to your memory. You will not forget them.",
                "value": "GOOD",
                "amount": 0
              }
            ]
          }
        }
