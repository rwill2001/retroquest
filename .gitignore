/bin/
/target/
.settings/
.metadata
*.class

# OS junk
.DS_Store
Thumbs.db

# Save games (runtime state)
saves/
*.sav

# Eclipse IDE project files (Maven builds without these)
.classpath
.project

# Claude Code local settings (personal overrides, not shared)
.claude/settings.local.json

# Runtime crash/diagnostic logs
logs/

# Generated classpath cache (rebuilt by the run-* launchers)
cp.txt

# Recorded footage — regenerate with tools/record.sh; the *shots* are versioned, not the video.
/out

# RetroForge editor state — last-opened map and view position, machine-local
data/.forge_prefs

# Shade would write this into the project root; generation is disabled in pom.xml
dependency-reduced-pom.xml
